{# templates/character/_form.html.twig #}
{{ form_start(form) }}

    <div class="space-y-6">
        {# Champ Nom du Personnage #}
        <div>
            {{ form_label(form.characterName, 'Nom du Personnage', {'label_attr': {'class': 'block mb-2 text-xs font-bold text-[#daa520] uppercase tracking-widest font-fantasy'}}) }}
            {{ form_widget(form.characterName, {'attr': {'class': 'w-full bg-black/40 border border-[#6d5d52] text-[#f0e6d2] rounded p-3 focus:border-[#daa520] focus:ring-1 focus:ring-[#daa520] focus:outline-none transition-colors placeholder-gray-600', 'placeholder': 'Ex: Arthas'}}) }}
            <div class="text-red-400 text-xs mt-1 font-bold">{{ form_errors(form.characterName) }}</div>
        </div>

        {# Ligne avec Serveur et Région #}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                {{ form_label(form.characterRealmSlug, 'Slug du Serveur', {'label_attr': {'class': 'block mb-2 text-xs font-bold text-[#daa520] uppercase tracking-widest font-fantasy'}}) }}
                {{ form_widget(form.characterRealmSlug, {'attr': {'class': 'w-full bg-black/40 border border-[#6d5d52] text-[#f0e6d2] rounded p-3 focus:border-[#daa520] focus:ring-1 focus:ring-[#daa520] focus:outline-none transition-colors placeholder-gray-600', 'placeholder': 'Ex: hyjal'}}) }}
                <div class="text-gray-500 text-[10px] mt-1 italic">Le nom du serveur en minuscule et sans espaces (ex: archimonde).</div>
                <div class="text-red-400 text-xs mt-1 font-bold">{{ form_errors(form.characterRealmSlug) }}</div>
            </div>
            <div>
                {{ form_label(form.characterRegion, 'Région', {'label_attr': {'class': 'block mb-2 text-xs font-bold text-[#daa520] uppercase tracking-widest font-fantasy'}}) }}
                {# On applique un style select custom #}
                {{ form_widget(form.characterRegion, {'attr': {'class': 'w-full bg-black/40 border border-[#6d5d52] text-[#f0e6d2] rounded p-3 focus:border-[#daa520] focus:ring-1 focus:ring-[#daa520] focus:outline-none appearance-none cursor-pointer'}}) }}
                <div class="text-red-400 text-xs mt-1 font-bold">{{ form_errors(form.characterRegion) }}</div>
            </div>
        </div>
    </div>

    <div class="mt-8 flex justify-end border-t border-[#6d5d52]/30 pt-6">
        <button class="wow-btn-refined">
            {{ button_label|default('Enregistrer') }} <span class="ml-2">Done</span>
        </button>
    </div>

{{ form_end(form) }}
