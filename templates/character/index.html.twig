{% extends 'base.html.twig' %}

{% block title %}Mes Personnages{% endblock %}

{% block body %}
{# CONFIGURATION DES COULEURS DE CLASSE #}
{% set classColors = {
    'Death Knight': '#C41E3A', 'Chevalier de la mort': '#C41E3A',
    'Demon Hunter': '#A330C9', 'Chasseur de démons': '#A330C9',
    'Druid': '#FF7D0A', 'Druide': '#FF7D0A',
    'Evoker': '#33937F', 'Évocateur': '#33937F',
    'Hunter': '#ABD473', 'Chasseur': '#ABD473',
    'Mage': '#40C7EB',
    'Monk': '#00FF96', 'Moine': '#00FF96',
    'Paladin': '#F58CBA',
    'Priest': '#FFFFFF', 'Prêtre': '#FFFFFF',
    'Rogue': '#FFF569', 'Voleur': '#FFF569',
    'Shaman': '#0070DE', 'Chaman': '#0070DE',
    'Warlock': '#8787ED', 'Démoniste': '#8787ED',
    'Warrior': '#C79C6E', 'Guerrier': '#C79C6E'
} %}

<div class="min-h-screen bg-[#0b0d12] text-[#c7b394] pb-20 relative font-sans">

    {# FOND D'ÉCRAN AVEC VIGNETTE #}
    <div class="fixed inset-0 z-0 pointer-events-none"
         style="background-image: url('https://bnetcmsus-a.akamaihd.net/cms/content_entry_media/2g/2G4V985U25I21596153195237.jpg'); background-size: cover; background-position: center;">
         <div class="absolute inset-0 bg-[#050505]/90 backdrop-blur-[2px]"></div>
         <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(circle, transparent 50%, #000 100%); opacity: 0.8;"></div>
    </div>

    <div class="relative z-10 container mx-auto px-4 py-12 max-w-[1400px]">

        {# ================================================= #}
        {#  ZONE DE NOTIFICATIONS (Flash Messages WoW Style) #}
        {# ================================================= #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="wow-panel mb-8 p-4 flex items-center gap-4 relative overflow-hidden animate-fade-in-down border-l-4
                    {{ label == 'success' ? 'border-l-[#20d662] bg-gradient-to-r from-[#0f2e1b] to-[#0b0d12]' : 'border-l-red-600 bg-gradient-to-r from-[#2e0f0f] to-[#0b0d12]' }}">

                    {# Icône selon le type #}
                    <div class="p-3 rounded-full border shadow-lg shrink-0
                        {{ label == 'success' ? 'bg-[#20d662]/10 border-[#20d662]/30 text-[#20d662]' : 'bg-red-600/10 border-red-600/30 text-red-500' }}">
                        {% if label == 'success' %}
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                        {% else %}
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        {% endif %}
                    </div>

                    <div>
                        <h4 class="font-fantasy text-lg tracking-wide mb-1 leading-none
                            {{ label == 'success' ? 'text-[#20d662]' : 'text-red-500' }}">
                            {{ label == 'success' ? 'Succès' : 'Attention' }}
                        </h4>
                        <p class="text-[#f0e6d2] text-sm font-medium">{{ message }}</p>
                    </div>

                    {# Petit effet de lumière en background #}
                    <div class="absolute -right-10 -top-10 w-32 h-32 blur-3xl rounded-full opacity-20 pointer-events-none
                        {{ label == 'success' ? 'bg-[#20d662]' : 'bg-red-600' }}"></div>
                </div>
            {% endfor %}
        {% endfor %}
        {# ================================================= #}


        {# EN-TÊTE #}
        <div class="flex flex-col md:flex-row justify-between items-end md:items-center mb-10 border-b border-[#6d5d52]/50 pb-6 gap-6">
            <div>
                <h1 class="text-4xl lg:text-5xl font-fantasy font-bold text-[#f0e6d2] tracking-widest mb-2 drop-shadow-lg text-center md:text-left">
                    BATAILLON
                </h1>
                <p class="text-[#8b7355] text-sm text-center md:text-left font-light tracking-wide">
                    Gérez vos héros et sélectionnez votre personnage principal pour l'armurerie.
                </p>
            </div>

            <div class="flex gap-4">
                <a href="{{ path('app_profile_index') }}" class="wow-btn-refined text-xs group">
                    <span class="group-hover:-translate-x-1 transition-transform">❮</span> Retour Profil
                </a>
                <a href="{{ path('app_character_new') }}" class="wow-btn-refined text-xs text-[#daa520]">
                    <span>+</span> Nouveau Personnage
                </a>
            </div>
        </div>

        {# GRILLE DES PERSONNAGES #}
        {% if app.user.characters is defined and app.user.characters is not empty %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {% for character in app.user.characters %}

                    {# Détermination si Actif #}
                    {% set isActive = (app.user.activeCharacter and app.user.activeCharacter.id == character.id) %}

                    {# Sécurisation des données #}
                    {% set className = character.class ? character.class.name : 'Inconnu' %}
                    {% set charColor = classColors[className] ?? '#6d5d52' %}
                    {% set charLevel = character.level ?? '??' %}
                    {% set charThumbnail = character.thumbnail ?? null %}

                    {# CARTE PERSONNAGE #}
                    <div class="character-card group rounded-sm {% if isActive %}active{% endif %}">

                        {# Barre de couleur de classe (Top Strip) #}
                        <div class="class-strip" style="background-color: {{ charColor }}; box-shadow: 0 0 10px {{ charColor }};"></div>

                        {# HEADER CARTE (Avatar + Infos) #}
                        <div class="p-5 flex items-center gap-5 relative z-10">

                            {# Avatar #}
                            <div class="relative shrink-0">
                                <div class="w-16 h-16 rounded overflow-hidden char-avatar bg-black flex items-center justify-center">
                                    {% if charThumbnail %}
                                        <img src="{{ charThumbnail }}" alt="{{ character.characterName }}" class="w-full h-full object-cover">
                                    {% else %}
                                        <span class="font-fantasy text-3xl font-bold" style="color: {{ charColor }}">{{ character.characterName|slice(0,1) }}</span>
                                    {% endif %}
                                </div>
                                {# Badge Niveau #}
                                <div class="absolute -bottom-2 -right-2 bg-[#0b0d12] text-[#f0e6d2] text-[10px] font-bold w-6 h-6 flex items-center justify-center rounded-full border border-[#6d5d52] shadow-md z-20">
                                    {{ charLevel }}
                                </div>
                            </div>

                            {# Infos Texte #}
                            <div class="flex-grow">
                                <h2 class="text-xl font-fantasy font-bold tracking-wide leading-none mb-1 transition-colors duration-300 group-hover:text-white" style="color: {{ isActive ? '#f0e6d2' : '#c7b394' }}">
                                    {{ character.characterName }}
                                </h2>
                                <p class="text-xs uppercase tracking-wider font-bold opacity-90" style="color: {{ charColor }}">
                                    {{ className }}
                                </p>
                                {% if character.activeSpec %}
                                    <p class="text-[10px] text-[#8b7355] mt-0.5 font-light">
                                        {{ character.activeSpec.name }}
                                    </p>
                                {% endif %}
                            </div>

                            {# Badge "Actif" #}
                            {% if isActive %}
                                <div class="absolute top-4 right-4">
                                    <span class="text-[9px] bg-[#daa520] text-black px-2 py-0.5 rounded-sm font-bold uppercase tracking-widest shadow-[0_0_10px_rgba(218,165,32,0.4)]">
                                        Main
                                    </span>
                                </div>
                            {% endif %}
                        </div>

                        {# INFO SERVEUR (Barre sombre) #}
                        <div class="px-5 py-2 bg-black/40 border-t border-white/5 flex justify-between items-center">
                            <span class="text-[10px] text-[#6d5d52] uppercase tracking-[0.15em] font-semibold">
                                {{ character.characterRealmSlug|capitalize }}
                            </span>
                            <span class="text-[9px] bg-[#222] text-[#666] px-1.5 rounded uppercase font-bold">
                                {{ character.characterRegion|upper }}
                            </span>
                        </div>

                        {# ACTIONS (Footer) #}
                        <div class="p-4 border-t border-[#6d5d52]/20 bg-[#111]/80 flex gap-3 justify-between items-center relative z-10">

                            {# Bouton Sélectionner #}
                            {% if not isActive %}
                                <form action="{{ path('app_character_set_active', {id: character.id}) }}" method="post" class="flex-grow">
                                    <button type="submit" class="btn-select w-full rounded-sm flex items-center justify-center gap-2 group-btn">
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#444] group-hover:bg-[#daa520] transition-colors"></span> Sélectionner
                                    </button>
                                </form>
                            {% else %}
                                <div class="flex-grow text-center text-[#daa520] text-[10px] font-fantasy tracking-[0.2em] opacity-80 py-1.5 select-none border border-transparent">
                                    ⚔ ACTIF ⚔
                                </div>
                            {% endif %}

                            {# Icônes Edit/Delete #}
                            <div class="flex gap-2 pl-3 border-l border-white/10">
                                <a href="{{ path('app_character_edit', {id: character.id}) }}" class="text-[#6d5d52] hover:text-[#daa520] transition-colors p-1" title="Modifier">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
                                </a>
                                <form action="{{ path('app_character_delete', {id: character.id}) }}" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer {{ character.characterName }} ?');" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ character.id) }}">
                                    <button type="submit" class="text-[#6d5d52] hover:text-red-500 transition-colors p-1" title="Supprimer">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            {# EMPTY STATE #}
            <div class="wow-panel p-20 text-center flex flex-col items-center justify-center border-dashed border-[#6d5d52]/30 bg-black/40 rounded">
                <div class="text-7xl mb-6 opacity-20 filter grayscale">🛡️</div>
                <h3 class="text-2xl font-fantasy text-[#daa520] mb-2">Le Bataillon est Vide</h3>
                <p class="text-[#8b7355] mb-8 max-w-md mx-auto">Importez votre premier personnage depuis l'Armurerie pour commencer.</p>
                <a href="{{ path('app_character_new') }}" class="wow-btn-refined scale-110">
                    <span class="text-[#daa520] font-bold text-lg">+</span> Ajouter un personnage
                </a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
