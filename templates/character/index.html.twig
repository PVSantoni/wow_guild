{% extends 'base.html.twig' %}

{% block title %}Mes Personnages{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#0b0d12] text-[#c7b394] pb-20 relative font-sans">
    {# Fond identique à l'armurerie #}
    <div class="fixed inset-0 z-0 pointer-events-none"
         style="background-image: url('https://bnetcmsus-a.akamaihd.net/cms/content_entry_media/2g/2G4V985U25I21596153195237.jpg'); background-size: cover; background-position: center;">
         <div class="absolute inset-0 bg-[#050505]/90 backdrop-blur-[2px]"></div>
    </div>

    <div class="relative z-10 container mx-auto px-4 py-12 max-w-[1400px]">

        {# HEADER & ACTIONS #}
        <div class="flex flex-col md:flex-row justify-between items-end md:items-center mb-10 border-b border-[#6d5d52]/50 pb-6 gap-6">
            <div>
                <h1 class="text-4xl font-fantasy font-bold text-[#f0e6d2] tracking-widest mb-2 drop-shadow-md">
                    MES PERSONNAGES
                </h1>
                <p class="text-[#8b7355] text-sm">Gérez votre bataillon et sélectionnez le héros actif pour l'armurerie.</p>
            </div>

            <div class="flex gap-4">
                <a href="{{ path('app_profile_index') }}" class="px-4 py-2 border border-[#6d5d52] text-[#8b7355] rounded hover:bg-[#6d5d52] hover:text-[#f0e6d2] transition-colors text-xs font-fantasy uppercase tracking-wider">
                    ❮ Retour Armurerie
                </a>
                <a href="{{ path('app_character_new') }}" class="wow-btn-refined">
                    <span class="text-lg leading-none mb-0.5">+</span> Nouveau Personnage
                </a>
            </div>
        </div>

        {# LISTE DES PERSONNAGES #}
        {% if app.user.characters is not empty %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for character in app.user.characters %}
                    {% set isActive = (app.user.activeCharacter == character) %}

                    <div class="wow-panel flex flex-col p-0 transition-transform duration-300 hover:-translate-y-1
                        {% if isActive %} border-[#daa520] shadow-[0_0_15px_rgba(218,165,32,0.2)] {% endif %}">

                        {# En-tête de la carte #}
                        <div class="p-4 bg-gradient-to-r from-black/60 to-transparent border-b border-[#6d5d52]/30 flex justify-between items-start">
                            <div>
                                <h2 class="text-xl font-fantasy font-bold {{ isActive ? 'text-[#daa520]' : 'text-[#f0e6d2]' }}">
                                    {{ character.characterName }}
                                </h2>
                                <p class="text-xs text-[#8b7355] uppercase tracking-wider mt-1">
                                    {{ character.characterRealmSlug }} — {{ character.characterRegion|upper }}
                                </p>
                            </div>
                            {% if isActive %}
                                <div class="bg-[#daa520] text-black text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-widest shadow-lg">
                                    Actif
                                </div>
                            {% endif %}
                        </div>

                        {# Corps (Placeholder pour image de classe ou autre info) #}
                        <div class="flex-grow p-6 bg-black/20 flex items-center justify-center">
                            <div class="text-5xl opacity-10 grayscale">🛡️</div>
                        </div>

                        {# Actions #}
                        <div class="p-4 border-t border-[#6d5d52]/30 bg-[#0b0d12]/40 flex flex-wrap gap-2 justify-between items-center">

                            {# Bouton ACTIVER #}
                            {% if not isActive %}
                                <form action="{{ path('app_character_set_active', {id: character.id}) }}" method="post" class="flex-grow">
                                    <button type="submit" class="w-full py-1.5 px-3 border border-[#6d5d52] text-[#c7b394] hover:border-[#daa520] hover:text-[#daa520] hover:bg-[#daa520]/10 rounded text-xs font-bold uppercase transition-all">
                                        Sélectionner
                                    </button>
                                </form>
                            {% else %}
                                <div class="flex-grow text-center text-[#daa520] text-xs font-fantasy tracking-widest opacity-80">
                                    &mdash; Personnage Principal &mdash;
                                </div>
                            {% endif %}

                            {# Actions Modifier / Supprimer #}
                            <div class="flex gap-2">
                                <a href="{{ path('app_character_edit', {id: character.id}) }}" class="p-2 border border-[#6d5d52] text-[#8b7355] hover:text-white hover:bg-[#6d5d52] rounded transition-colors" title="Modifier">
                                    ✎
                                </a>
                                <form action="{{ path('app_character_delete', {id: character.id}) }}" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer {{ character.characterName }} ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ character.id) }}">
                                    <button type="submit" class="p-2 border border-[#b91c1c] text-[#b91c1c] hover:bg-[#b91c1c] hover:text-white rounded transition-colors" title="Supprimer">
                                        ✕
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            {# Empty State #}
            <div class="wow-panel p-16 text-center flex flex-col items-center justify-center">
                <div class="text-6xl mb-4 opacity-30 grayscale">📜</div>
                <p class="text-[#8b7355] text-lg mb-6">Votre liste de personnages est vide.</p>
                <a href="{{ path('app_character_new') }}" class="wow-btn-refined">
                    Ajouter mon premier personnage
                </a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
