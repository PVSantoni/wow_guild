{% extends 'base.html.twig' %}

{% block title %}Modifier {{ character.characterName }}{% endblock %}

{% block body %}
<div class="container mx-auto max-w-2xl">
    <div class="text-center mb-8">
        <h1 class="text-4xl font-fantasy header-title">
            Modifier le Personnage
        </h1>
        <p class="text-lg text-yellow-400 mt-2">{{ character.characterName }}</p>
    </div>

    <div class="wow-panel">
        <div class="wow-panel-header">
            Informations du Personnage
        </div>
        <div class="p-8">
            {# On réutilise notre formulaire stylisé, en changeant juste le texte du bouton #}
            {{ include('character/_form.html.twig', {'button_label': 'Mettre à Jour'}) }}
        </div>
    </div>

    {# --- Section "Zone de Danger" pour la suppression --- #}
    <div class="mt-8 wow-panel border-red-500/50 hover:!border-red-500">
        <div class="p-6">
            <div class="flex justify-between items-center">
                <div>
                    <h3 class="font-bold text-red-400">Supprimer ce personnage</h3>
                    <p class="text-sm text-gray-400">Cette action est irréversible.</p>
                </div>
                {# Le formulaire de suppression pointe vers la route 'delete' #}
                <form method="post" action="{{ path('app_character_delete', {'id': character.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer définitivement {{ character.characterName|e('js') }} ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ character.id) }}">
                    <button class="wow-button">Supprimer</button>
                </form>
            </div>
        </div>
    </div>

    <div class="text-center mt-8">
        <a href="{{ path('app_character_index') }}" class="text-gray-400 hover:text-white hover:underline transition-colors">
            &larr; Retour à la gestion des personnages
        </a>
    </div>
</div>
{% endblock %}
