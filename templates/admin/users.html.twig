{% extends 'base.html.twig' %}

{% block title %}Gestion des Membres{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-white mb-6 border-b border-gray-700 pb-2">
        Gestion des Membres
    </h1>

    <div class="bg-gray-800 rounded-lg shadow-lg overflow-x-auto">
        <table class="min-w-full text-left text-sm text-gray-300">
            <thead class="bg-gray-900 text-xs text-gray-400 uppercase">
                <tr>
                    <th scope="col" class="px-6 py-3">Pseudo</th>
                    <th scope="col" class="px-6 py-3">Email</th>
                    <th scope="col" class="px-6 py-3">Rôle Admin</th> {# Colonne renommée pour la clarté #}
                    <th scope="col" class="px-6 py-3">Rang de Guilde</th> {# NOUVELLE COLONNE #}
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr class="border-b border-gray-700 hover:bg-gray-700">
                        <td class="px-6 py-4 font-medium text-white">{{ user.pseudo }}</td>
                        <td class="px-6 py-4">{{ user.email }}</td>
                        <td class="px-6 py-4">
                            {# Logique pour le rôle ADMIN (Promouvoir / Rétrograder) #}
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="bg-yellow-500 text-gray-900 text-xs font-semibold px-2.5 py-0.5 rounded">Admin</span>
                                {% if user.id != app.user.id %}
                                    <form action="{{ path('app_admin_user_demote', {id: user.id}) }}" method="post" class="inline ml-2">
                                        <button type="submit" class="font-medium text-red-500 hover:underline text-xs">(Rétrograder)</button>
                                    </form>
                                {% endif %}
                            {% else %}
                                <span class="bg-blue-500 text-white text-xs font-semibold px-2.5 py-0.5 rounded">Utilisateur</span>
                                {% if user.id != app.user.id %}
                                <form action="{{ path('app_admin_user_promote', {id: user.id}) }}" method="post" class="inline ml-2">
                                    <button type="submit" class="font-medium text-green-500 hover:underline text-xs">(Promouvoir)</button>
                                </form>
                                {% endif %}
                            {% endif %}
                        </td>
                        <td class="px-6 py-4">
                            {# NOUVEAU FORMULAIRE POUR LE RANG DE GUILDE #}
                            {% if user.id != app.user.id %}
                                <form action="{{ path('app_admin_user_update_rank', {id: user.id}) }}" method="post" class="flex items-center gap-2">
                                    <select name="guildRank" class="bg-gray-700 border border-gray-600 text-white text-sm rounded-lg focus:ring-yellow-500 focus:border-yellow-500 block w-full p-1.5">
                                        {# On boucle sur notre constante pour créer les options #}
                                        {% for rank in constant('App\\Entity\\User::RANKS') %}
                                            <option value="{{ rank }}" {% if rank == user.guildRank %}selected{% endif %}>
                                                {{ rank }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    <button type="submit" class="px-3 py-1.5 text-xs font-medium text-center text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-800">OK</button>
                                </form>
                            {% else %}
                                <span class="text-gray-500 italic">{{ user.guildRank }} (Vous)</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center py-4">Aucun utilisateur trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
