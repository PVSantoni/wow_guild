{% extends 'base.html.twig' %}

{% block title %}Gestion des Membres{% endblock %}



{% block body %}
<div class="container mx-auto px-4 py-8 max-w-6xl">

    {# TITRE STYLISÉ #}
    <div class="text-center mb-8">
        <h1 class="text-4xl font-fantasy header-title">
            Gestion des Membres
        </h1>
    </div>

    {# PANEL WOW #}
    <div class="wow-panel overflow-hidden">
        <div class="wow-panel-header flex justify-between items-center">
            <span>Liste de l'effectif</span>
            <span class="text-xs text-yellow-600 normal-case">{{ users|length }} membres</span>
        </div>

        <div class="overflow-x-auto">
            {# On applique la classe .wow-table définie dans ton CSS principal #}
            <table class="w-full text-left text-sm wow-table">
                <thead>
                    <tr>
                        <th scope="col">Pseudo</th>
                        <th scope="col">Email</th>
                        <th scope="col">Rôle Admin</th>
                        <th scope="col">Rang de Guilde</th>
                    </tr>
                </thead>
                <tbody class="text-gray-300">
                    {% for user in users %}
                        <tr>
                            <td class="font-bold text-[#c7b394]">{{ user.pseudo }}</td>
                            <td class="text-gray-400">{{ user.email }}</td>
                            <td>
                                {# Rôle ADMIN (Promouvoir / Rétrograder) #}
                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <span class="bg-yellow-900/50 text-yellow-400 border border-yellow-700 text-xs font-semibold px-2.5 py-0.5 rounded uppercase tracking-wider">Admin</span>
                                    {% if user.id != app.user.id %}
                                        <form action="{{ path('app_admin_user_demote', {id: user.id}) }}" method="post" class="inline ml-2">
                                            <button type="submit" class="font-medium text-red-400 hover:text-red-300 hover:underline text-xs transition-colors" onclick="return confirm('Êtes-vous sûr de vouloir retirer les droits admin ?')">
                                                (Rétrograder)
                                            </button>
                                        </form>
                                    {% endif %}
                                {% else %}
                                    <span class="bg-blue-900/50 text-blue-400 border border-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded uppercase tracking-wider">Membre</span>
                                    {% if user.id != app.user.id %}
                                    <form action="{{ path('app_admin_user_promote', {id: user.id}) }}" method="post" class="inline ml-2">
                                        <button type="submit" class="font-medium text-green-400 hover:text-green-300 hover:underline text-xs transition-colors" onclick="return confirm('Donner les droits administrateur ?')">
                                            (Promouvoir)
                                        </button>
                                    </form>
                                    {% endif %}
                                {% endif %}
                            </td>
                            <td>
                                {# FORMULAIRE RANG DE GUILDE #}
                                {% if user.id != app.user.id %}
                                    <form action="{{ path('app_admin_user_update_rank', {id: user.id}) }}" method="post" class="flex items-center gap-2">
                                        <select name="guildRank" class="wow-select text-xs rounded p-1.5 w-40">
                                            {% for rank in constant('App\\Entity\\User::RANKS') %}
                                                <option value="{{ rank }}" {% if rank == user.guildRank %}selected{% endif %}>
                                                    {{ rank }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                        {# Petit bouton OK doré #}
                                        <button type="submit" class="wow-button" style="padding: 0.2rem 0.8rem; font-size: 0.7rem; border-width: 1px;">
                                            OK
                                        </button>
                                    </form>
                                {% else %}
                                    <span class="text-gray-500 italic text-xs">{{ user.guildRank }} (Vous)</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center py-8 italic text-gray-500">
                                <div class="flex flex-col items-center gap-2">
                                    <span class="text-2xl">📜</span>
                                    Aucun membre trouvé dans les registres.
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# BOUTON RETOUR EN BAS À GAUCHE #}
    <div class="mt-8">
        <a href="{{ path('app_admin_dashboard') }}" class="wow-btn-refined">
            <span class="arrow">❮</span>
            <span>Retour Dashboard</span>
        </a>
    </div>

</div>
{% endblock %}
