{% extends 'base.html.twig' %}

{% block title %}Dashboard Administrateur{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-fantasy header-title text-center mb-8">
        Panneau de Contrôle
    </h1>

    {# ======================================= #}
    {# SECTION 1 : LES 4 CARTES D'ACTION       #}
    {# ======================================= #}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">

        {# --- CARTE 1 : CRÉER UN ÉVÉNEMENT --- #}
        <a href="{{ path('app_evenement_new') }}" class="wow-panel group block hover:!border-green-500 transition-all duration-300 transform hover:-translate-y-1">
            <div class="p-6 text-center">
                <div class="flex justify-center mb-4">
                    <div class="w-16 h-16 rounded-full bg-green-500/10 border-2 border-green-500/30 flex items-center justify-center text-green-400 group-hover:scale-110 group-hover:bg-green-500/20 transition-transform duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    </div>
                </div>
                <h2 class="text-2xl font-fantasy text-white mb-2 group-hover:text-green-400 transition-colors">Créer un Événement</h2>
                <p class="text-gray-400">Organiser une nouvelle activité pour la guilde.</p>
            </div>
        </a>

        {# --- CARTE 2 : GÉRER LES ÉVÉNEMENTS --- #}
        <a href="{{ path('app_admin_evenement_list') }}" class="wow-panel group block hover:!border-blue-500 transition-all duration-300 transform hover:-translate-y-1">
            <div class="p-6 text-center">
                <div class="flex justify-center mb-4">
                    <div class="w-16 h-16 rounded-full bg-blue-500/10 border-2 border-blue-500/30 flex items-center justify-center text-blue-400 group-hover:scale-110 group-hover:bg-blue-500/20 transition-transform duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
                    </div>
                </div>
                <h2 class="text-2xl font-fantasy text-white mb-2 group-hover:text-blue-400 transition-colors">Gérer les Événements</h2>
                <p class="text-gray-400">Consulter les raids et modifier les rosters.</p>
            </div>
        </a>

        {# --- CARTE 3 : GÉRER LES MEMBRES --- #}
        <a href="{{ path('app_admin_users') }}" class="wow-panel group block hover:!border-purple-500 transition-all duration-300 transform hover:-translate-y-1">
            <div class="p-6 text-center">
                 <div class="flex justify-center mb-4">
                    <div class="w-16 h-16 rounded-full bg-purple-500/10 border-2 border-purple-500/30 flex items-center justify-center text-purple-400 group-hover:scale-110 group-hover:bg-purple-500/20 transition-transform duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M15 21a6 6 0 00-9-5.197m0 0A4 4 0 119.646 3.646 4 4 0 0112 4.354z" /></svg>
                    </div>
                </div>
                <h2 class="text-2xl font-fantasy text-white mb-2 group-hover:text-purple-400 transition-colors">Gérer les Membres</h2>
                <p class="text-gray-400">Gérer les rôles et les rangs de guilde.</p>
            </div>
        </a>

        {# --- CARTE 4 : GÉRER LES LISTES BIS --- #}
        <a href="{{ path('app_bis_list_index') }}" class="wow-panel group block hover:!border-yellow-500 transition-all duration-300 transform hover:-translate-y-1">
            <div class="p-6 text-center">
                 <div class="flex justify-center mb-4">
                    <div class="w-16 h-16 rounded-full bg-yellow-500/10 border-2 border-yellow-500/30 flex items-center justify-center text-yellow-400 group-hover:scale-110 group-hover:bg-yellow-500/20 transition-transform duration-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
                    </div>
                </div>
                <h2 class="text-2xl font-fantasy text-white mb-2 group-hover:text-yellow-400 transition-colors">Gérer les Listes BiS</h2>
                <p class="text-gray-400">Créer et mettre à jour les listes "Best in Slot".</p>
            </div>
        </a>

    </div>

    {# ======================================= #}
    {# SECTION 2 : ACCÈS RAPIDE AUX ROSTERS    #}
    {# ======================================= #}
    <h2 class="text-2xl font-fantasy header-title text-center mb-6">Accès Rapide aux Rosters Récents</h2>
    <div class="wow-panel max-w-4xl mx-auto">
        <ul class="divide-y divide-gray-700">
            {% for event in recentEvents %}
                {% set isPast = event.dateDebut < date('now') %}
                <a href="{{ path('app_admin_evenement_roster', {id: event.id}) }}" class="block hover:bg-gray-700/50 transition-colors duration-200 {{ isPast ? 'opacity-60' : '' }}">
                    <li class="p-4 flex justify-between items-center">
                        <div>
                            <p class="font-bold text-lg text-yellow-400 flex items-center gap-3">
                                {{ event.nom }}
                                {% if isPast %}<span class="text-xs bg-gray-600 text-gray-300 px-2 py-0.5 rounded-full">Terminé</span>{% endif %}
                            </p>
                            <p class="text-sm text-gray-400">{{ event.dateDebut|date('d/m/Y à H:i') }} - <span class="font-semibold">{{ event.inscriptions|length }}</span> inscrit(s)</p>
                        </div>
                        <span class="text-gray-500 text-2xl font-bold">&rarr;</span>
                    </li>
                </a>
            {% else %}
                <li class="p-6 text-center text-gray-500 italic">Aucun événement à gérer.</li>
            {% endfor %}
        </ul>
    </div>
</div>
{% endblock %}


