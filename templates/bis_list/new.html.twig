{% extends 'base.html.twig' %}

{% block title %}Nouvelle BiS List{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#0b0d12] py-12" style="background-image: url('https://bnetcmsus-a.akamaihd.net/cms/content_entry_media/2g/2G4V985U25I21596153195237.jpg'); background-attachment: fixed; background-size: cover;">
    <div class="container mx-auto px-4 max-w-5xl">

        <div class="wow-form-card">
            <div class="flex justify-between items-center mb-6">
                <h1 class="wow-form-title mb-0">Créer une BiS List</h1>
                <a href="{{ path('app_bis_list_index') }}" class="text-[#8b7355] hover:text-[#daa520] transition-colors font-fantasy">
                    ↩ Retour à la liste
                </a>
            </div>

            {{ include('bis_list/_form.html.twig') }}
        </div>

    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const classSelect = document.getElementById('bis_list_characterClass');
    const specSelect = document.getElementById('bis_list_specialization');

    // On mappe la VALEUR de la classe (ex: MAGE) avec le TEXTE qu'on cherche (ex: (Mage))
    // Cela permet d'éviter d'afficher "Givre (DK)" quand on sélectionne "Mage" (qui a aussi Givre)
    const classLabelMapping = {
        'DEATH_KNIGHT': '(DK)',
        'DRUID':        '(Druide)',
        'HUNTER':       '(Chasseur)',
        'MAGE':         '(Mage)',
        'MONK':         '(Moine)',
        'PALADIN':      '(Paladin)',
        'PRIEST':       '(Prêtre)',
        'ROGUE':        '(Voleur)',
        'SHAMAN':       '(Chaman)',
        'WARLOCK':      '(Démoniste)',
        'WARRIOR':      '(Guerrier)'
    };

    function updateSpecs() {
        const selectedClassValue = classSelect.value; // Ex: MAGE
        const textFilter = classLabelMapping[selectedClassValue]; // Ex: (Mage)

        // 1. On cache tout d'abord
        // (On laisse l'option vide "Choisir..." visible si elle est sélectionnée)
        let hasSelection = false;

        for (let i = 0; i < specSelect.options.length; i++) {
            const option = specSelect.options[i];

            // Si c'est le placeholder (valeur vide), on le laisse
            if (option.value === "") {
                continue;
            }

            // LOGIQUE : On regarde si le TEXTE de l'option contient le nom de la classe
            // Ex: "Givre (Mage)" contient "(Mage)" -> ON AFFICHE
            if (textFilter && option.text.includes(textFilter)) {
                option.style.display = 'block'; // Afficher
                option.disabled = false;        // Activer
            } else {
                option.style.display = 'none';  // Cacher
                option.disabled = true;         // Désactiver (pour empêcher la soumission)
            }
        }

        // Reset de la valeur si l'option sélectionnée est devenue invisible
        const currentOption = specSelect.options[specSelect.selectedIndex];
        if (currentOption && currentOption.style.display === 'none') {
            specSelect.value = "";
        }
    }

    if (classSelect && specSelect) {
        classSelect.addEventListener('change', updateSpecs);
        // Lancer au chargement pour corriger l'état initial
        updateSpecs();
    }
});
</script>
{% endblock %}


