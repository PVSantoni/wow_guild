{% extends 'base.html.twig' %}

{% block title %}Nouvelle BiS List{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8 max-w-3xl">

    {# TITRE #}
    <div class="text-center mb-8">
        <h1 class="text-4xl font-fantasy header-title">
            Créer une BiS List
        </h1>
    </div>

    {# PANEL FORMULAIRE #}
    <div class="wow-panel">
        <div class="wow-panel-header">
            Configuration du personnage
        </div>
        <div class="p-6">
            {# Le formulaire est inclus ici #}
            {{ include('bis_list/_form.html.twig') }}
        </div>
    </div>

    {# BARRE D'ACTIONS #}
    <div class="mt-8 flex justify-between items-center">

        {# GAUCHE : Retour #}
        <a href="{{ path('app_bis_list_index') }}" class="wow-btn-refined">
            <span class="arrow">❮</span>
            <span>Retour à la liste</span>
        </a>

        {# DROITE : Enregistrer #}
        {#
           CORRECTION ICI :
           J'ai ajouté 'inline-flex items-center justify-center gap-2'
           et un style="" pour forcer l'affichage en ligne si le CSS wow-button résiste.
        #}
        <button type="button"
                onclick="document.querySelector('form[name=bis_list]').submit();"
                class="wow-button inline-flex items-center justify-center gap-2"
                style="display: inline-flex;">

            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Enregistrer la liste</span>
        </button>

    </div>

</div>

{# SCRIPT DE FILTRAGE #}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const classSelect = document.getElementById('bis_list_characterClass');
        const specSelect = document.getElementById('bis_list_specialization');

        if (!classSelect || !specSelect) return;

        const classLabelMapping = {
            'DEATH_KNIGHT': '(DK)', 'DRUID': '(Druide)', 'HUNTER': '(Chasseur)',
            'MAGE': '(Mage)', 'MONK': '(Moine)', 'PALADIN': '(Paladin)',
            'PRIEST': '(Prêtre)', 'ROGUE': '(Voleur)', 'SHAMAN': '(Chaman)',
            'WARLOCK': '(Démoniste)', 'WARRIOR': '(Guerrier)'
        };

        function updateSpecs() {
            const selectedClassValue = classSelect.value;
            const textFilter = classLabelMapping[selectedClassValue];

            for (let i = 0; i < specSelect.options.length; i++) {
                const option = specSelect.options[i];
                if (option.value === "") continue;

                if (!selectedClassValue) {
                    option.hidden = true;
                    continue;
                }

                if (textFilter && option.text.includes(textFilter)) {
                    option.hidden = false;
                    option.disabled = false;
                } else {
                    option.hidden = true;
                    option.disabled = true;
                }
            }
            if (specSelect.selectedIndex >= 0 && specSelect.options[specSelect.selectedIndex].hidden) {
                specSelect.value = "";
            }
        }

        classSelect.addEventListener('change', updateSpecs);
        updateSpecs();
    });
</script>
{% endblock %}
