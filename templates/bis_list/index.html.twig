{% extends 'base.html.twig' %}

{% block title %}Liste des BiS{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#0b0d12] py-12" style="background-image: url('https://bnetcmsus-a.akamaihd.net/cms/content_entry_media/2g/2G4V985U25I21596153195237.jpg'); background-attachment: fixed; background-size: cover; background-position: center;">
    <div class="container mx-auto px-4 max-w-6xl">

        <div class="wow-admin-container bg-black/80 p-6 rounded border border-[#444]">
            <!-- Header du tableau -->
            <div class="wow-admin-header flex justify-between items-center mb-6 border-b border-[#333] pb-4">
                <h1 class="text-[#daa520] font-bold text-2xl uppercase font-serif tracking-widest">📚 Registre des BiS Lists</h1>
                <a href="{{ path('app_bis_list_new') }}" class="btn-create-new bg-[#b8860b] hover:bg-[#8b6914] text-white py-2 px-4 rounded border border-[#daa520] transition">
                    + Nouvelle Liste
                </a>
            </div>

            <!-- Le tableau -->
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="text-[#8b7355] border-b border-[#333]">
                            <th class="p-3">Nom de la liste</th>
                            <th class="p-3">Classe</th>
                            <th class="p-3">Spécialisation</th>
                            <th class="p-3 text-center">Items</th>
                            <th class="p-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm">
                    {% for bis_list in bis_lists %}
                        <tr class="border-b border-[#222] hover:bg-[#ffffff05] transition">
                            <td class="p-3 font-bold text-[#f0e6d2]">
                                {{ bis_list.name }}
                            </td>
                            <td class="p-3">
                                {#
                                   GÉNÉRATION DYNAMIQUE DE LA CLASSE CSS :
                                   1. lower : met en minuscule (ex: "MAGE" devient "mage")
                                   2. replace : change les espaces/underscore en tirets (ex: "DEATH_KNIGHT" -> "death-knight")
                                   Résultat : class="class-badge type-mage" ou "type-death-knight"
                                #}
                                <span class="class-badge type-{{ bis_list.characterClass|lower|replace({' ': '-', '_': '-'}) }}">
                                    {{ bis_list.characterClass }}
                                </span>
                            </td>
                            <td class="p-3">
                                <span class="text-gray-400">{{ bis_list.specialization }}</span>
                            </td>
                            <td class="p-3 text-center">
                                <span class="text-xs font-mono bg-black/50 px-2 py-1 rounded border border-gray-700 text-gray-300">
                                    {{ bis_list.bisItems|length }} / 16
                                </span>
                            </td>
                            <td class="p-3 text-right space-x-2">
                                <a href="{{ path('app_bis_list_show', {'id': bis_list.id}) }}" class="text-[#40C7EB] hover:underline">Voir</a>
                                <a href="{{ path('app_bis_list_edit', {'id': bis_list.id}) }}" class="text-[#daa520] hover:underline">Éditer</a>

                                <form method="post" action="{{ path('app_bis_list_delete', {'id': bis_list.id}) }}" onsubmit="return confirm('Supprimer cette liste ?');" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ bis_list.id) }}">
                                    <button class="text-red-500 hover:text-red-400 font-bold px-2">✕</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-8 text-gray-500 italic">
                                Le registre est vide... Pour l'instant.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>
{% endblock %}
