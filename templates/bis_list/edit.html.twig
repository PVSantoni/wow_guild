{% extends 'base.html.twig' %}

{% block title %}Nouvelle BiS List{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8 max-w-3xl">

    {# TITRE CENTRÉ #}
    <div class="text-center mb-8">
        <h1 class="text-4xl font-fantasy header-title">
            Créer une BiS List
        </h1>
    </div>

    {# PANEL FORMULAIRE #}
    <div class="wow-panel">
        <div class="wow-panel-header">
            Configuration du personnage
        </div>
        <div class="p-6">
            {# Le formulaire est inclus ici #}
            {{ include('bis_list/_form.html.twig') }}
        </div>
    </div>

    {# BARRE D'ACTIONS (Bas de page) #}
    <div class="mt-8 flex justify-between items-center">

        {# GAUCHE : Retour (Style Raffiné) #}
        <a href="{{ path('app_bis_list_index') }}" class="wow-btn-refined">
            <span class="arrow">❮</span>
            <span>Retour à la liste</span>
        </a>

        {# DROITE : Créer (Style Doré) #}
        {# On utilise du JS pour soumettre le formulaire qui est inclus au-dessus #}
        {# NOTE: Assure-toi d'avoir retiré le bouton 'Save' dans _form.html.twig #}
        <button type="button" onclick="document.querySelector('form').submit();" class="wow-button">
            Enregistrer la liste
        </button>

    </div>

</div>

{# SCRIPT DE FILTRAGE (Placé ici pour charger après le HTML) #}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // On récupère les éléments
        const classSelect = document.getElementById('bis_list_characterClass');
        const specSelect = document.getElementById('bis_list_specialization');

        // Sécurité : Si les champs n'existent pas sur la page, on arrête tout pour éviter l'erreur
        if (!classSelect || !specSelect) return;

        // Mapping Valeur technique -> Texte affiché dans l'option
        const classLabelMapping = {
            'DEATH_KNIGHT': '(DK)',
            'DRUID':        '(Druide)',
            'HUNTER':       '(Chasseur)',
            'MAGE':         '(Mage)',
            'MONK':         '(Moine)',
            'PALADIN':      '(Paladin)',
            'PRIEST':       '(Prêtre)',
            'ROGUE':        '(Voleur)',
            'SHAMAN':       '(Chaman)',
            'WARLOCK':      '(Démoniste)',
            'WARRIOR':      '(Guerrier)'
        };

        function updateSpecs() {
            const selectedClassValue = classSelect.value;
            const textFilter = classLabelMapping[selectedClassValue];

            // On parcourt toutes les options du select de Spécialisation
            for (let i = 0; i < specSelect.options.length; i++) {
                const option = specSelect.options[i];

                // On garde le placeholder (ex: "Choisir une spé") visible
                if (option.value === "") continue;

                // Si aucune classe n'est sélectionnée, on cache tout (sauf le placeholder)
                if (!selectedClassValue) {
                    option.hidden = true; // 'hidden' est plus robuste que style.display pour les options
                    continue;
                }

                // Si le texte de l'option contient le filtre (ex: "(Mage)"), on affiche
                if (textFilter && option.text.includes(textFilter)) {
                    option.hidden = false;
                    option.disabled = false;
                } else {
                    option.hidden = true;
                    option.disabled = true;
                }
            }

            // Si l'option actuellement sélectionnée devient invisible, on remet à zéro
            const currentOption = specSelect.options[specSelect.selectedIndex];
            if (currentOption && currentOption.hidden) {
                specSelect.value = "";
            }
        }

        // Écouteur d'événement
        classSelect.addEventListener('change', updateSpecs);

        // Lancement initial (au cas où on arrive sur la page avec des valeurs pré-remplies)
        updateSpecs();
    });
</script>
{% endblock %}
