{# templates/bis_list/_form.html.twig #}

{{ form_start(form) }}

    <div class="space-y-6">

        {# ================================================================= #}
        {# PARTIE 1 : CONFIGURATION ET IMPORT (TOUJOURS VISIBLE)             #}
        {# ================================================================= #}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            {# 1. NOM #}
            <div class="md:col-span-2">
                {{ form_label(form.name, 'Nom de la Liste', {'label_attr': {'class': 'block mb-2 text-sm font-bold text-[#daa520]'}}) }}
                {{ form_widget(form.name, {'attr': {'class': 'w-full bg-gray-900 border border-[#6d5d52] rounded p-2 text-[#c7b394] focus:border-[#daa520] focus:ring-1 focus:ring-[#daa520] outline-none transition-colors'}}) }}
                <div class="text-red-500 text-xs mt-1">{{ form_errors(form.name) }}</div>
            </div>

            {# 2. CLASSE #}
            <div>
                {{ form_label(form.characterClass, 'Classe', {'label_attr': {'class': 'block mb-2 text-sm font-bold text-[#daa520]'}}) }}
                {{ form_widget(form.characterClass, {'attr': {'class': 'w-full wow-select rounded p-2'}}) }}
            </div>

            {# 3. SPECIALISATION #}
            <div>
                {{ form_label(form.specialization, 'Spécialisation', {'label_attr': {'class': 'block mb-2 text-sm font-bold text-[#daa520]'}}) }}
                {{ form_widget(form.specialization, {'attr': {'class': 'w-full wow-select rounded p-2'}}) }}
            </div>

            {# 4. JSON IMPORT (CORRIGÉ : wowsimsJson) #}
            {% if form.wowsimsJson is defined %}
                <div class="md:col-span-2 pt-4 mt-2 border-t border-[#6d5d52]/30">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="text-lg">📜</span>
                        {# Label manuel pour le style #}
                        <label class="text-sm font-bold text-[#f0e6d2] mb-0">Import JSON Wowsims (Optionnel)</label>
                    </div>

                    {{ form_widget(form.wowsimsJson, {'attr': {
                        'class': 'w-full bg-black/40 border border-[#6d5d52] rounded p-3 text-xs font-mono text-gray-300 focus:border-[#daa520] outline-none shadow-inner',
                        'rows': 4,
                        'placeholder': '{ "items": [...] } \nCollez votre export JSON ici pour remplir automatiquement les items ci-dessous.'
                    }}) }}

                    <div class="text-red-500 text-xs">{{ form_errors(form.wowsimsJson) }}</div>
                </div>
            {% endif %}

        </div>


        {# ================================================================= #}
        {# PARTIE 2 : ITEMS (ACCORDÉON DÉPLIABLE)                            #}
        {# ================================================================= #}
        <div class="pt-2">
            <details class="group bg-black/20 rounded border border-[#6d5d52]/50 open:bg-black/40 transition-all duration-300">

                <summary class="flex justify-between items-center cursor-pointer p-4 select-none hover:bg-[#daa520]/10 transition-colors rounded-t">
                    <span class="text-[#8b7355] group-hover:text-[#daa520] font-fantasy tracking-wide text-base flex items-center gap-2 transition-colors">
                        🛡️ Saisie Manuelle (Item par Item)
                    </span>
                    <span class="transform group-open:rotate-180 transition-transform duration-300 text-[#daa520]">
                        ▼
                    </span>
                </summary>

                <div class="p-6 border-t border-[#6d5d52]/30 grid grid-cols-1 md:grid-cols-2 gap-4 animate-fadeIn">

                    {# BOUCLE INTELLIGENTE #}
                    {% for field in form %}


                        {% if not field.rendered and field.vars.name != '_token' %}
                            <div>
                                {{ form_label(field, null, {'label_attr': {'class': 'block text-[10px] font-bold text-[#8b7355] uppercase mb-1 tracking-wider'}}) }}
                                {{ form_widget(field, {'attr': {'class': 'w-full bg-black/50 border border-[#6d5d52] rounded px-2 py-1.5 text-sm text-white focus:border-[#daa520] outline-none transition-colors', 'placeholder': 'ID item...'}}) }}
                                <div class="text-red-500 text-xs">{{ form_errors(field) }}</div>
                            </div>
                        {% endif %}

                    {% endfor %}

                </div>
            </details>
        </div>

    </div>

    {# Bouton caché pour le script JS #}
    <div class="hidden">
        <button type="submit">Save</button>
    </div>

{{ form_end(form) }}

<style>
    details > summary { list-style: none; }
    details > summary::-webkit-details-marker { display: none; }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-5px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn { animation: fadeIn 0.2s ease-out; }
</style>
