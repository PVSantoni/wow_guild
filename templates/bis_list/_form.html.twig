{{ form_start(form, {'attr': {'class': 'wow-form'}}) }}

    {# --- SECTION 1 : INFOS GÉNÉRALES --- #}
    <div class="mb-8 p-4 border border-[#8b7355] rounded bg-black/30">
        <h3 class="text-[#daa520] font-fantasy mb-4 border-b border-[#8b7355]/50 pb-2">Informations Générales</h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                {{ form_label(form.name, 'Nom de la liste (ex: PVE Raid)', {'label_attr': {'class': 'wow-label'}}) }}
                {{ form_widget(form.name, {'attr': {'class': 'w-full'}}) }}
                {{ form_errors(form.name) }}
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    {{ form_label(form.characterClass, 'Classe', {'label_attr': {'class': 'wow-label'}}) }}
                    {{ form_widget(form.characterClass) }}
                </div>
                <div>
                    {{ form_label(form.specialization, 'Spécialisation', {'label_attr': {'class': 'wow-label'}}) }}
                    {{ form_widget(form.specialization) }}
                </div>
            </div>
        </div>

        {# --- AJOUT : Affichage du champ JSON ici (pour ne pas casser la grille en bas) --- #}
        <div class="mt-4 pt-4 border-t border-[#8b7355]/30">
             {{ form_label(form.wowsimsJson, null, {'label_attr': {'class': 'wow-label text-sm text-gray-400'}}) }}
             {{ form_widget(form.wowsimsJson, {'attr': {'class': 'w-full bg-black/50 text-xs text-gray-300 border-gray-600', 'rows': 3}}) }}
        </div>
    </div>

    {# --- SECTION 2 : LES ÉQUIPEMENTS (IDs) --- #}
    <h3 class="text-[#daa520] font-fantasy mb-4 text-xl text-center">— Identifiants des Items BiS —</h3>
    <p class="text-gray-500 text-center text-sm mb-6 italic">Entrez l'ID Wowhead de l'item pour chaque emplacement.</p>

    <div class="wow-grid-slots">
        {# On boucle sur les champs restants #}
        {% for field in form %}
            {# MODIFICATION ICI : J'ai ajouté 'wowsimsJson' dans la liste pour l'exclure de la grille #}
            {% if field.vars.name not in ['name', 'characterClass', 'specialization', '_token', 'wowsimsJson'] %}
                <div class="wow-slot-item">
                    {{ form_label(field, null, {'label_attr': {'class': 'wow-label'}}) }}
                    {{ form_widget(field, {'attr': {'placeholder': 'Ex: 12345'}}) }}
                    {{ form_errors(field) }}
                </div>
            {% endif %}
        {% endfor %}
    </div>

    <button class="btn-save wow-button mt-8">
        💾 Sauvegarder la BiS List
    </button>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const classSelect = document.getElementById('bis_list_characterClass');
    const specSelect = document.getElementById('bis_list_specialization');

    if (!classSelect || !specSelect) {
        console.error("❌ ERREUR : Champs introuvables.");
        return;
    }

    // MAP : Valeur de la Classe (API) => Suffixe présent dans le Label (Entité PHP)
    // Cela permet de différencier "Restoration (Druide)" de "Restoration (Chaman)"
    const classLabelFilters = {
        'DEATH_KNIGHT': '(DK)',
        'DRUID':        '(Druide)',
        'HUNTER':       '(Chasseur)',
        'MAGE':         '(Mage)',
        'MONK':         '(Moine)',
        'PALADIN':      '(Paladin)',
        'PRIEST':       '(Prêtre)',
        'ROGUE':        '(Voleur)',
        'SHAMAN':       '(Chaman)',
        'WARLOCK':      '(Démoniste)',
        'WARRIOR':      '(Guerrier)'
    };

    function updateSpecs() {
        const selectedClass = classSelect.value; // ex: 'DRUID'

        // On récupère le bout de texte qu'on cherche (ex: '(Druide)')
        const textFilter = classLabelFilters[selectedClass];

        // On parcourt toutes les options du select Spécialisation
        for (let i = 0; i < specSelect.options.length; i++) {
            const option = specSelect.options[i];

            // On ne touche pas au placeholder vide
            if (option.value === "") continue;

            // Si on a une classe sélectionnée ET que le texte de l'option contient le bon label
            if (textFilter && option.text.includes(textFilter)) {
                option.style.display = 'block'; // On affiche
                option.disabled = false;        // On active
            } else {
                option.style.display = 'none';  // On cache
                option.disabled = true;         // On désactive
            }
        }

        // Si l'option actuellement choisie est maintenant masquée, on reset sur vide
        const currentOption = specSelect.options[specSelect.selectedIndex];
        if (currentOption && currentOption.style.display === 'none') {
            specSelect.value = "";
        }
    }

    classSelect.addEventListener('change', updateSpecs);
    updateSpecs(); // Lancement initial
});
</script>

{{ form_end(form) }}
