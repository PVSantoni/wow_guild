{# Ce formulaire est conçu pour fonctionner avec form_start, form_end et form_row dans le template parent si besoin #}
{{ form_start(form) }}

    {# On affiche les erreurs générales du formulaire s'il y en a #}
    {{ form_errors(form) }}

    {# Champ Nom #}
    <div class="mb-4">
        {{ form_label(form.nom, 'Nom de l\'événement', {'label_attr': {'class': 'block mb-2 text-sm font-bold text-yellow-400'}}) }}
        {{ form_widget(form.nom, {'attr': {'class': 'bg-gray-700 border border-gray-600 text-white text-sm rounded-lg focus:ring-yellow-500 focus:border-yellow-500 block w-full p-2.5'}}) }}
    </div>

    {# Champ Catégorie #}
    <div class="mb-4">
        {{ form_label(form.categorie, 'Catégorie', {'label_attr': {'class': 'block mb-2 text-sm font-bold text-yellow-400'}}) }}
        {{ form_widget(form.categorie, {'attr': {'class': 'bg-gray-700 border border-gray-600 text-white text-sm rounded-lg focus:ring-yellow-500 focus:border-yellow-500 block w-full p-2.5'}}) }}
    </div>

    {# Champ Description #}
    <div class="mb-4">
        {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block mb-2 text-sm font-bold text-yellow-400'}}) }}
        {{ form_widget(form.description, {'attr': {'class': 'bg-gray-700 border border-gray-600 text-white text-sm rounded-lg focus:ring-yellow-500 focus:border-yellow-500 block w-full p-2.5', 'rows': 5}}) }}
    </div>

    {# Ligne avec Date et Nombre de places #}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-4">
        <div>
            {{ form_label(form.dateDebut, 'Date et Heure', {'label_attr': {'class': 'block mb-2 text-sm font-bold text-yellow-400'}}) }}
            {{ form_widget(form.dateDebut, {'attr': {'class': 'bg-gray-700 border border-gray-600 text-white text-sm rounded-lg focus:ring-yellow-500 focus:border-yellow-500 block w-full p-2.5'}}) }}
        </div>
        <div>
            {{ form_label(form.nbPlacesMax, 'Nombre de places', {'label_attr': {'class': 'block mb-2 text-sm font-bold text-yellow-400'}}) }}
            {{ form_widget(form.nbPlacesMax, {'attr': {'class': 'bg-gray-700 border border-gray-600 text-white text-sm rounded-lg focus:ring-yellow-500 focus:border-yellow-500 block w-full p-2.5'}}) }}
        </div>
    </div>

    {# Le bouton de soumission est maintenant un wow-button ! #}
    <button class="wow-button w-full mt-6">
        {{ button_label|default('Enregistrer') }}
    </button>

{{ form_end(form) }}
