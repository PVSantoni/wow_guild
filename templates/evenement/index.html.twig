{% extends 'base.html.twig' %}

{% block title %}Calendrier des Événements{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Style spécifique pour les boutons de filtre (Onglets) */
        .wow-filter-btn {
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid #6d5d52;
            color: #8b7355;
            font-family: 'Cinzel', serif;
            font-size: 0.75rem;
            padding: 0.4rem 1rem;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            text-decoration: none;
            border-radius: 2px;
        }
        .wow-filter-btn:hover {
            border-color: #daa520;
            color: #f0e6d2;
            background: rgba(218, 165, 32, 0.1);
            box-shadow: 0 0 10px rgba(218, 165, 32, 0.15);
        }
        /* Tu pourras ajouter une classe .active via JS ou Twig si tu veux marquer la sélection */
    </style>
{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8 max-w-7xl">

    {# 1. EN-TÊTE #}
    <div class="flex flex-col md:flex-row justify-between items-end mb-8 gap-4">
        <div>
            <h1 class="text-4xl font-fantasy header-title mb-1">Prochains Événements</h1>
            <p class="text-gray-500 text-sm italic">Préparez-vous au combat.</p>
        </div>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_evenement_new') }}" class="wow-button flex items-center gap-2" style="font-size: 0.8rem; padding: 0.6rem 1.2rem;">
                <span>+</span> Créer un événement
            </a>
        {% endif %}
    </div>

    {# 2. FILTRES (Style Onglets WoW) #}
    <div class="flex items-center justify-center md:justify-start flex-wrap gap-2 mb-10 border-b border-[#6d5d52]/30 pb-4">
        <span class="text-[#6d5d52] text-xs uppercase font-bold mr-2 tracking-widest hidden md:inline">Filtres :</span>

        <a href="{{ path('app_evenement_index') }}" class="wow-filter-btn">
            Tous
        </a>
        {% for categorie in categories %}
            <a href="{{ path('app_evenement_filter_category', {id: categorie.id}) }}" class="wow-filter-btn">
                {{ categorie.nom }}
            </a>
        {% endfor %}
    </div>

    {# 3. GRILLE D'ÉVÉNEMENTS #}
    {% if evenements|length > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for evenement in evenements %}
                {# On vérifie si l'event est passé pour le griser #}
                {% set isPast = evenement.dateDebut < date('now') %}

                <div class="wow-panel flex flex-col justify-between h-full group transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(218,165,32,0.15)] {{ isPast ? 'opacity-60 grayscale' : '' }}">

                    {# Header de la carte #}
                    <div class="wow-panel-header flex justify-between items-start h-16 gap-2">
                        <h2 class="text-lg font-bold leading-tight text-[#f0e6d2] group-hover:text-white transition-colors line-clamp-2">
                            {{ evenement.nom }}
                        </h2>
                        {% if evenement.categorie %}
                            <span class="shrink-0 text-[10px] uppercase font-bold tracking-wider border border-[#daa520]/40 text-[#daa520] px-2 py-0.5 rounded bg-black/40">
                                {{ evenement.categorie.nom }}
                            </span>
                        {% endif %}
                    </div>

                    {# Contenu #}
                    <div class="p-5 flex-grow flex flex-col gap-4">

                        {# Date et Heure #}
                        <div class="flex items-center gap-2 text-[#daa520] font-bold border-b border-[#6d5d52]/30 pb-2">
                            <span class="text-lg">📅</span>
                            {{ evenement.dateDebut ? evenement.dateDebut|date('d/m/Y') : '' }}
                            <span class="text-gray-500 text-sm font-normal ml-auto font-mono">
                                {{ evenement.dateDebut ? evenement.dateDebut|date('H:i') : '' }}
                            </span>
                        </div>

                        {# Description courte #}
                        <p class="text-gray-400 text-sm italic line-clamp-3 min-h-[3rem]">
                            {{ evenement.description ? evenement.description|striptags|slice(0, 100) ~ '...' : 'Aucune description disponible.' }}
                        </p>

                        {# Barre de Progression (Roster) #}
                        <div class="mt-auto">
                            {% set inscritCount = evenement.inscriptions|length %}
                            {% set maxCount = evenement.nbPlacesMax %}
                            {% set percent = maxCount > 0 ? (inscritCount / maxCount) * 100 : 0 %}

                            <div class="flex justify-between text-[10px] text-gray-500 mb-1 uppercase font-bold tracking-wider">
                                <span>Roster</span>
                                <span class="{{ inscritCount >= maxCount ? 'text-green-400' : 'text-[#c7b394]' }}">
                                    {{ inscritCount }} / {{ maxCount }}
                                </span>
                            </div>
                            <div class="w-full bg-black/60 h-1.5 rounded-full border border-[#333]">
                                <div class="h-full rounded-full {{ percent >= 100 ? 'bg-red-600' : 'bg-[#daa520]' }} transition-all duration-1000" style="width: {{ percent }}%"></div>
                            </div>
                        </div>
                    </div>

                    {# Footer (Bouton) #}
                    <div class="p-4 pt-0">
                        <a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" class="wow-button w-full block text-center">
                            {{ isPast ? 'Voir le résumé' : 'S\'inscrire / Détails' }}
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        {# 4. ÉTAT VIDE #}
        <div class="wow-panel text-center p-12 flex flex-col items-center justify-center min-h-[300px]">
            <span class="text-4xl mb-4 opacity-50 grayscale">📯</span>
            <h3 class="text-xl font-fantasy text-[#daa520] mb-2">Le calme avant la tempête</h3>
            <p class="text-gray-400">Aucun événement n'est programmé pour le moment.</p>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_evenement_new') }}" class="mt-6 text-sm text-[#8b7355] hover:text-[#daa520] underline transition-colors">
                    Programmer un raid maintenant
                </a>
            {% endif %}
        </div>
    {% endif %}

</div>
{% endblock %}
