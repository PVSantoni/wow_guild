{% extends 'base.html.twig' %}

{% block title %}Calendrier des Événements{% endblock %}

{% block body %}
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-4xl font-fantasy header-title">Prochains Événements</h1>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_evenement_new') }}" class="wow-button">
                Créer un événement
            </a>
        {% endif %}
    </div>

    {# Filtres par catégorie #}
    <div class="flex items-center justify-center flex-wrap gap-2 mb-8">
        <a href="{{ path('app_evenement_index') }}" class="bg-gray-700 hover:bg-purple-600 text-white font-bold py-2 px-4 rounded transition-colors duration-200">
            Tous
        </a>
        {% for categorie in categories %}
            <a href="{{ path('app_evenement_filter_category', {id: categorie.id}) }}" class="bg-gray-700 hover:bg-purple-600 text-white font-bold py-2 px-4 rounded transition-colors duration-200">
                {{ categorie.nom }}
            </a>
        {% endfor %}
    </div>

    {% if evenements|length > 0 %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for evenement in evenements %}
                <div class="wow-panel flex flex-col justify-between h-full">
                    <div class="wow-panel-header flex justify-between items-center">
                        <h2 class="text-lg font-bold truncate">{{ evenement.nom }}</h2>
                        {% if evenement.categorie %}
                            <span class="bg-purple-600 text-white text-xs font-semibold px-2.5 py-1 rounded-full whitespace-nowrap">
                                {{ evenement.categorie.nom }}
                            </span>
                        {% endif %}
                    </div>

                    <div class="p-4 flex-grow">
                        <p class="text-yellow-400 font-semibold mb-3">{{ evenement.dateDebut ? evenement.dateDebut|date('d/m/Y à H:i') : '' }}</p>
                        <p class="text-gray-300 text-sm">{{ evenement.description|slice(0, 120) ~ '...' }}</p>
                    </div>

                    <div class="p-4 pt-0">
                        <a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" class="wow-button w-full">
                            Voir les détails
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="wow-panel text-center p-8">
            <p class="text-gray-400">Il n'y a aucun événement de prévu pour le moment.</p>
        </div>
    {% endif %}

{% endblock %}
