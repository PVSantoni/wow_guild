{% extends 'base.html.twig' %}

{% block title %}{{ evenement.nom }}{% endblock %}

{% block body %}
    {# --- DÉFINITIONS --- #}
    {% set classColors = {
        'DEATH_KNIGHT': '#C41F3B', 'DRUID': '#FF7D0A', 'HUNTER': '#ABD473',
        'MAGE': '#69CCF0', 'PALADIN': '#F58CBA', 'PRIEST': '#FFFFFF',
        'ROGUE': '#FFF569', 'SHAMAN': '#0070DE', 'WARLOCK': '#9482C9',
        'WARRIOR': '#C79C6E', 'MONK': '#00FF96', 'DEMON_HUNTER': '#A330C9', 'EVOKER': '#33937F'
    } %}
    {% set roleIcons = {
        'Tank': '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd" /></svg>',
        'Soigneur': '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" /></svg>',
        'DPS': '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" clip-rule="evenodd" /></svg>'
    } %}

    <div class="container mx-auto">

        <div class="text-center mb-8">
            <h1 class="text-5xl font-fantasy header-title mb-2">{{ evenement.nom }}</h1>
            <p class="text-gray-400 text-lg">Le {{ evenement.dateDebut|date('l d F Y à H:i') }}</p>
        </div>

        <div class="wow-panel mb-8">
            <div class="wow-panel-header">Description</div>
            <div class="p-6 text-gray-300">{{ evenement.description|nl2br }}</div>
        </div>

        {% if is_granted('ROLE_USER') %}
            <div class="wow-panel mb-8">
                <div class="wow-panel-header">Gérer ma participation</div>
                <div class="p-6">
                    {% set userInscription = null %}{% if app.user %}{% for inscription in evenement.inscriptions %}{% if inscription.user.id == app.user.id %}{% set userInscription = inscription %}{% endif %}{% endfor %}{% endif %}
                    {% if userInscription %}
                        <div class="text-center">
                            {% set statusColor = 'text-gray-400' %}{% if userInscription.statut == 'Confirmé' %}{% set statusColor = 'text-green-400' %}{% elseif userInscription.statut == 'En attente' %}{% set statusColor = 'text-yellow-400' %}{% endif %}
                            <p class="text-lg mb-4 {{ statusColor }}">Votre statut : <span class="font-bold">{{ userInscription.statut }}</span>{% if userInscription.playedRole %} en tant que <span class="font-bold">{{ userInscription.playedRole }}</span>{% endif %}</p>
                            <form action="{{ path('app_evenement_inscription', {id: evenement.id}) }}" method="post" class="inline"><input type="hidden" name="statut" value="Absent"><button type="submit" class="wow-button">Se désinscrire</button></form>
                        </div>
                    {% else %}
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            {% for role in constant('App\\Entity\\Inscription::ROLES') %}
                                <div class="wow-panel text-center border border-[#8b7355]/50 bg-black/30"><div class="wow-panel-header">{{ role }}</div><div class="p-4"><form action="{{ path('app_evenement_inscription', {id: evenement.id}) }}" method="post"><input type="hidden" name="statut" value="Confirmé"><input type="hidden" name="role" value="{{ role }}"><div class="space-y-4"><div><label for="class-select-{{ role }}" class="wow-label text-left block text-sm mb-1 text-yellow-500">Classe</label><select name="characterClass" id="class-select-{{ role }}" required class="w-full class-select bg-gray-700 border border-gray-600 text-white rounded-lg p-2.5 focus:border-yellow-500 focus:ring-yellow-500"><option value="">Choisissez...</option>{% for class in classes %}<option value="{{ class.apiKey }}">{{ class.name }}</option>{% endfor %}</select></div><div><label for="spec-select-{{ role }}" class="wow-label text-left block text-sm mb-1 text-yellow-500">Spécialisation</label><select name="specialization" id="spec-select-{{ role }}" required class="w-full spec-select bg-gray-700 border border-gray-600 text-white rounded-lg p-2.5 focus:border-yellow-500 focus:ring-yellow-500"><option value="">Choisissez une classe...</option>{% for spec in specializations %}<option value="{{ spec.id }}">{{ spec.name }}</option>{% endfor %}</select></div></div><button type="submit" class="wow-button w-full mt-6">S'inscrire</button></form></div></div>
                            {% endfor %}
                        </div>
                        <div class="text-center mt-8"><form action="{{ path('app_evenement_inscription', {id: evenement.id}) }}" method="post" class="inline"><input type="hidden" name="statut" value="Incertain"><button type="submit" class="text-gray-400 hover:text-white hover:underline text-sm">Je ne suis pas sûr (Incertain)</button></form></div>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        {# ======================================================= #}
        {# SECTION "COMPOSITION DU ROSTER"                         #}
        {# ======================================================= #}
        <div class="wow-panel mb-8">
            <div class="wow-panel-header">Composition du Roster Confirmé</div>
            <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-6">
                {% set confirmedInscriptions = evenement.inscriptions|filter(i => i.statut == 'Confirmé') %}
                {% for role in constant('App\\Entity\\Inscription::ROLES') %}
                    {% set participantsInRole = confirmedInscriptions|filter(i => i.playedRole == role) %}{% set current = participantsInRole|length %}{% set required = (role == 'Tank') ? evenement.tanksRequis : ( (role == 'Soigneur') ? evenement.soigneursRequis : evenement.dpsRequis ) %}{% set percentage = required > 0 ? (current / required) * 100 : 0 %}{% set barColor = 'bg-green-600' %}{% set textColor = 'text-green-400' %}{% if percentage >= 100 %}{% set barColor = 'bg-red-600' %}{% set textColor = 'text-red-400' %}{% elseif percentage >= 75 %}{% set barColor = 'bg-yellow-500' %}{% set textColor = 'text-yellow-400' %}{% endif %}
                    <div>
                        <div class="flex justify-between items-center mb-1"><div class="flex items-center gap-2">{{ roleIcons[role]|raw }}<span class="font-bold text-white">{{ role }}s</span></div><span class="text-sm font-semibold {{ textColor }}">{{ current }} / {{ required }}</span></div>
                        <div class="w-full bg-black/50 rounded-full h-2.5 border border-gray-700"><div class="h-2.5 rounded-full {{ barColor }} transition-all duration-500" style="width: {{ percentage }}%"></div></div>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# ======================================================= #}
        {# AFFICHAGE DÉTAILLÉ DES PARTICIPANTS                     #}
        {# ======================================================= #}
        <h2 class="text-3xl font-fantasy header-title text-center mb-6">Liste des Participants</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {% for role in constant('App\\Entity\\Inscription::ROLES') %}
                {% set participantsInRole = confirmedInscriptions|filter(i => i.playedRole == role) %}
                <div class="wow-panel h-full flex flex-col">
                    <div class="wow-panel-header flex justify-between items-center"><div class="flex items-center gap-2">{{ roleIcons[role]|raw }}<span>{{ role }}s</span></div></div>
                    <div class="p-2 flex-grow bg-black bg-opacity-20"><ul class="space-y-2">
                        {% for inscription in participantsInRole %}
                            {% set pColor = '#9CA3AF' %}{% if inscription.specialization %}{% set pColor = classColors[inscription.specialization.characterClass.apiKey]|default('#9CA3AF') %}{% endif %}
                            <li class="bg-gray-800 border border-gray-700 rounded p-2 flex items-center gap-3 hover:bg-gray-750 transition duration-200">
                                <div class="w-1.5 h-10 rounded-sm shrink-0" style="background-color: {{ pColor }};"></div>
                                <div class="flex-grow">
                                    <div class="flex justify-between items-center">
                                        {# LIEN PROFIL PUBLIC #}
                                        <a href="{{ path('app_public_profile', {id: inscription.user.id}) }}"
                                           class="font-bold text-gray-100 hover:underline"
                                           style="color: {{ pColor }}; text-shadow: 1px 1px 0 #000;">
                                            {{ inscription.user.pseudo }}
                                        </a>
                                        {% if 'ROLE_ADMIN' in inscription.user.roles %}<span class="text-[10px] text-gray-500 border border-gray-600 px-1 rounded">OFFI</span>{% endif %}
                                    </div>
                                    <div class="text-xs text-gray-400 flex items-center gap-1 mt-0.5">{% if inscription.specialization %}<span class="text-gray-300">{{ inscription.specialization.name|replace({ ('(' ~ inscription.specialization.characterClass.name ~ ')') : ''})|trim }}</span><span class="text-gray-600 px-1">•</span><span style="color: {{ pColor }}">{{ inscription.specialization.characterClass.name }}</span>{% else %}<span class="italic text-gray-500">Pas de détails</span>{% endif %}</div>
                                </div>
                                {% if is_granted('ROLE_ADMIN') %}<form action="{{ path('app_inscription_update_status', {id: inscription.id}) }}" method="post" class="inline"><select name="status" onchange="this.form.submit()" class="text-xs bg-gray-900 border-gray-700 rounded p-1 focus:ring-yellow-500 focus:border-yellow-500"><option value="Confirmé" selected>Confirmé</option><option value="En attente">Mettre en attente</option></select></form>{% endif %}
                            </li>
                        {% else %}
                            <li class="text-gray-500 italic text-sm text-center py-4 border border-dashed border-gray-700 rounded mt-2">Recherche {{ role }}...</li>
                        {% endfor %}
                    </ul></div>
                </div>
            {% endfor %}
        </div>

        {# ======================================================= #}
        {# BANC DE TOUCHE ET INCERTAINS                            #}
        {# ======================================================= #}
        {% set standbyInscriptions = evenement.inscriptions|filter(i => i.statut == 'En attente') %}{% set uncertainInscriptions = evenement.inscriptions|filter(i => i.statut == 'Incertain') %}
        {% if standbyInscriptions is not empty or uncertainInscriptions is not empty %}
        <div class="mt-8 wow-panel bg-opacity-75">
            <div class="wow-panel-header text-gray-400 border-gray-700">Remplaçants & Incertains</div>
            <div class="p-4 space-y-2">
                {% for inscription in standbyInscriptions %}
                    <div class="flex justify-between items-center text-sm">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-yellow-500"></span>
                            {# LIEN PROFIL PUBLIC (En Attente) #}
                            <a href="{{ path('app_public_profile', {id: inscription.user.id}) }}" class="text-yellow-400 font-bold hover:underline">
                                {{ inscription.user.pseudo }}
                            </a>
                            <span class="text-gray-500">({{ inscription.playedRole }})</span>
                        </div>
                        {% if is_granted('ROLE_ADMIN') %}<div class="flex items-center gap-2"><form action="{{ path('app_inscription_update_status', {id: inscription.id}) }}" method="post" class="inline"><input type="hidden" name="status" value="Confirmé"><button type="submit" class="text-xs bg-green-700 hover:bg-green-600 text-white font-bold py-1 px-2 rounded transition-colors">Confirmer</button></form><form action="{{ path('app_inscription_remove', {id: inscription.id}) }}" method="post" class="inline"><button type="submit" class="text-xs bg-red-800 hover:bg-red-700 text-white font-bold py-1 px-2 rounded transition-colors" onclick="return confirm('Retirer {{ inscription.user.pseudo|e('js') }} de la liste ?')">&times;</button></form></div>{% endif %}
                    </div>
                {% endfor %}
                {% for inscription in uncertainInscriptions %}
                    <div class="flex justify-between items-center text-sm">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-gray-600"></span>
                            {# LIEN PROFIL PUBLIC (Incertain) #}
                            <a href="{{ path('app_public_profile', {id: inscription.user.id}) }}" class="text-gray-400 hover:text-white hover:underline">
                                {{ inscription.user.pseudo }}
                            </a>
                        </div>
                        {% if is_granted('ROLE_ADMIN') %}<div class="flex items-center gap-2"><form action="{{ path('app_inscription_update_status', {id: inscription.id}) }}" method="post" class="inline"><input type="hidden" name="status" value="Confirmé"><button type="submit" class="text-xs bg-green-700 hover:bg-green-600 text-white font-bold py-1 px-2 rounded transition-colors">Confirmer</button></form><form action="{{ path('app_inscription_remove', {id: inscription.id}) }}" method="post" class="inline"><button type="submit" class="text-xs bg-red-800 hover:bg-red-700 text-white font-bold py-1 px-2 rounded transition-colors" onclick="return confirm('Retirer {{ inscription.user.pseudo|e('js') }} de la liste ?')">&times;</button></form></div>{% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# ======================================================= #}
        {# BOUTONS DE NAVIGATION                                   #}
        {# ======================================================= #}
        <hr class="my-8 border-gray-700">
        <div class="flex items-center justify-center space-x-4 pb-12">
            <a href="{{ path('app_evenement_index') }}" class="wow-button">Voir tous les événements</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="wow-button">Modifier l'Événement</a>
                {{ include('evenement/_delete_form.html.twig') }}
            {% endif %}
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const classLabelFilters = { 'WARRIOR': '(Guerrier)', 'PALADIN': '(Paladin)', 'HUNTER': '(Chasseur)', 'ROGUE': '(Voleur)', 'PRIEST': '(Prêtre)', 'DEATH_KNIGHT': '(Chevalier de la mort)', 'SHAMAN': '(Chaman)', 'MAGE': '(Mage)', 'WARLOCK': '(Démoniste)', 'DRUID': '(Druide)', 'MONK': '(Moine)'};
            const inscriptionForms = document.querySelectorAll('form[action*="/inscription"]');
            inscriptionForms.forEach(form => {
                const classSelect = form.querySelector('.class-select');
                const specSelect = form.querySelector('.spec-select');
                if (!classSelect || !specSelect) return;
                const updateSpecs = () => {
                    const selectedClass = classSelect.value;
                    const textFilter = classLabelFilters[selectedClass];
                    for (let option of specSelect.options) {
                        if (option.value === "") continue;
                        const isVisible = textFilter && option.text.includes(textFilter);
                        option.style.display = isVisible ? 'block' : 'none';
                        option.disabled = !isVisible;
                    }
                    const currentOption = specSelect.options[specSelect.selectedIndex];
                    if (currentOption && currentOption.style.display === 'none') { specSelect.value = ""; }
                };
                classSelect.addEventListener('change', updateSpecs);
                updateSpecs();
            });
        });
    </script>
{% endblock %}
