{% extends 'base.html.twig' %}

{% block title %}Connexion - La Guilde{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-12 flex justify-center items-center min-h-[80vh]">
    <div class="wow-panel w-full max-w-md p-8 relative">
        <!-- Décoration dorée en haut -->
        <div class="class-strip bg-[#daa520] absolute top-0 left-0 w-full h-1"></div>

        <h1 class="text-2xl mb-8 text-center font-fantasy text-[#daa520] uppercase tracking-widest">
            Portail de Connexion
        </h1>

        <!-- Affichage des erreurs -->
        {% if error %}
            <div class="mb-6 p-3 border border-red-800 bg-red-900/30 text-red-200 text-sm rounded text-center font-bold">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" class="space-y-6">
            <div>
                <label for="inputEmail" class="wow-label">Email</label>
                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="wow-input" autocomplete="email" required autofocus placeholder="votre@email.com">
            </div>

            <div>
                <label for="inputPassword" class="wow-label">Mot de passe</label>
                <input type="password" name="password" id="inputPassword" class="wow-input" autocomplete="current-password" required placeholder="••••••••">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="flex items-center gap-3">
                <input type="checkbox" name="_remember_me" id="_remember_me" class="w-4 h-4 accent-[#daa520] cursor-pointer bg-gray-900 border-gray-600">
                <label for="_remember_me" class="text-sm text-[#c7b394] cursor-pointer hover:text-[#daa520]">
                    Se souvenir de moi
                </label>
            </div>

            <button type="submit" class="wow-btn-submit">
                Entrer dans le monde
            </button>
        </form>

        <div class="mt-6 text-center text-xs text-[#8b7355]">
            Pas encore de compte ? <a href="{{ path('app_register') }}" class="text-[#daa520] hover:underline">Créer un personnage</a>
        </div>
    </div>
</div>
{% endblock %}
