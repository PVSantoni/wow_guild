{% extends 'base.html.twig' %}

{% block title %}Accueil - Calendrier de la Guilde{% endblock %}

{% block body %}
    {# --- DÉFINITION DES VARIABLES ET ICÔNES --- #}
    {% set currentWeekOffset = app.request.query.get('week', 0) %}

    {% set roleIcons = {
        'Tank': '<svg class="h-4 w-4 text-blue-400 inline filter drop-shadow-md" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd" /></svg>',
        'Soigneur': '<svg class="h-4 w-4 text-green-400 inline filter drop-shadow-md" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" /></svg>',
        'DPS': '<svg class="h-4 w-4 text-red-500 inline filter drop-shadow-md" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" clip-rule="evenodd" /></svg>'
    } %}

    <div class="container mx-auto px-4 pb-12">

        {# ======================================= #}
        {# 1. TITRE ET NAVIGATION SEMAINE          #}
        {# ======================================= #}
        <h1 class="text-5xl font-fantasy header-title text-center mb-6 text-yellow-500 drop-shadow-[0_2px_2px_rgba(0,0,0,0.8)]">
            Programme de la Guilde
        </h1>

        {# BARRE DE NAVIGATION SEMAINE #}
        <div class="flex justify-center items-center gap-6 mb-12">
            {# Bouton Précédent #}
            <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'week': currentWeekOffset - 1})) }}"
               class="group flex items-center justify-center w-12 h-12 bg-black border-2 border-gray-600 rounded-full hover:border-[#ffd700] hover:bg-gray-900 transition-all shadow-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 group-hover:text-[#ffd700]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
            </a>

            {# Affichage Date #}
            <div class="text-center px-6 py-2 bg-black/40 border-y border-[#bfa670]/30 backdrop-blur-sm min-w-[250px]">
                <span class="block text-gray-400 text-xs uppercase tracking-widest">Semaine du</span>
                <div class="text-xl font-fantasy text-yellow-100">
                    {{ weekDays|first|date('d M') }} <span class="text-gray-500 mx-2">-</span> {{ weekDays|last|date('d M') }}
                </div>
                {% if currentWeekOffset != 0 %}
                    <a href="{{ path(app.request.attributes.get('_route')) }}" class="text-xs text-blue-400 hover:text-blue-300 hover:underline mt-1 block">
                        Revenir à aujourd'hui
                    </a>
                {% endif %}
            </div>

            {# Bouton Suivant #}
            <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'week': currentWeekOffset + 1})) }}"
               class="group flex items-center justify-center w-12 h-12 bg-black border-2 border-gray-600 rounded-full hover:border-[#ffd700] hover:bg-gray-900 transition-all shadow-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 group-hover:text-[#ffd700]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </a>
        </div>


        {# ======================================= #}
        {# 2. CALENDRIER HEBDOMADAIRE              #}
        {# ======================================= #}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-7 gap-4 mb-20">
            {% for day in weekDays %}
                {% set dayKey = day|date('Y-m-d') %}
                {% set eventsToday = calendarEvents[dayKey] ?? [] %}
                {% set isToday = (day|date('Y-m-d') == 'now'|date('Y-m-d')) %}
                {% set isPast = date(day) < date('now', 'Europe/Paris') and not isToday %}

                {# --- LA CARTE DU JOUR --- #}
                <div class="wow-panel relative flex flex-col min-h-[500px] transition-all duration-300 group/card
                    {% if isToday %}
                        lg:scale-105 z-20 border-2 border-yellow-400 bg-gradient-to-b from-[#4a3f23] via-[#1a1505] to-[#000] shadow-[0_0_40px_rgba(234,179,8,0.3)]
                    {% elseif isPast %}
                        border-t-4 border-gray-700 opacity-50 bg-black/40 grayscale
                    {% else %}
                        border-t-4 border-gray-600 bg-black/30 hover:bg-gray-800 hover:border-gray-500
                    {% endif %}
                ">
                    {# Badge "Aujourd'hui" #}
                    {% if isToday %}
                        <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-yellow-600 text-white text-xs font-bold px-6 py-1.5 rounded border border-yellow-400 uppercase tracking-widest shadow-lg whitespace-nowrap z-30">
                            Aujourd'hui
                        </div>
                    {% endif %}

                    {# En-tête de la carte #}
                    <div class="p-4 text-center border-b border-gray-700/50 bg-black/20">
                        <h3 class="font-bold uppercase tracking-wider font-fantasy {{ isToday ? 'text-yellow-400 text-2xl' : 'text-gray-300 text-xl' }}">
                            {{ day|date('l')|trans }}
                        </h3>
                        <span class="text-sm font-sans {{ isToday ? 'text-yellow-200' : 'text-gray-500' }}">
                            {{ day|date('d F') }}
                        </span>
                    </div>

                    {# Liste des événements #}
                    <div class="p-3 flex-grow flex flex-col gap-4 overflow-y-auto custom-scrollbar">
                        {% if eventsToday is not empty %}
                            {% for event in eventsToday %}
                                <div class="bg-gray-900/60 border border-gray-700 rounded-lg p-3 flex flex-col gap-3 shadow-inner hover:border-gray-500 transition-all group h-full">

                                    {# Titre et Heure #}
                                    <div class="flex justify-between items-start border-b border-gray-700 pb-2">
                                        <h4 class="font-bold text-yellow-100 group-hover:text-yellow-400 leading-tight text-lg drop-shadow-sm truncate pr-2">
                                            {{ event.nom }}
                                        </h4>
                                        <span class="text-xs font-mono text-white bg-gray-700 px-1.5 py-0.5 rounded shadow whitespace-nowrap">
                                            {{ event.dateDebut|date('H:i') }}
                                        </span>
                                    </div>

                                    {# Stats Roster #}
                                    <div class="grid grid-cols-3 gap-1 text-xs text-gray-300 bg-black/50 rounded py-2 border border-gray-800">
                                        <div class="flex flex-col items-center border-r border-gray-800">
                                            {{ roleIcons['Tank']|raw }}
                                            <span class="font-bold text-blue-200">{{ event.inscriptions|filter(i => i.playedRole == 'Tank' and i.statut == 'Confirmé')|length }}</span>
                                        </div>
                                        <div class="flex flex-col items-center border-r border-gray-800">
                                            {{ roleIcons['Soigneur']|raw }}
                                            <span class="font-bold text-green-200">{{ event.inscriptions|filter(i => i.playedRole == 'Soigneur' and i.statut == 'Confirmé')|length }}</span>
                                        </div>
                                        <div class="flex flex-col items-center">
                                            {{ roleIcons['DPS']|raw }}
                                            <span class="font-bold text-red-200">{{ event.inscriptions|filter(i => i.playedRole == 'DPS' and i.statut == 'Confirmé')|length }}</span>
                                        </div>
                                    </div>

                                    {# Liste Pseudos #}
                                    <div class="space-y-1 flex-grow">
                                        <div class="flex flex-wrap gap-1 content-start">
                                            {% set confirmed = event.inscriptions|filter(i => i.statut == 'Confirmé') %}
                                            {% for inscription in confirmed|slice(0, 15) %}
                                                <span class="bg-gray-800 text-gray-300 px-1.5 py-0.5 rounded text-[9px] border border-gray-600 truncate max-w-[80px]">
                                                    {{ inscription.user.pseudo }}
                                                </span>
                                            {% endfor %}
                                            {% if confirmed|length > 15 %}
                                                <span class="bg-gray-700 text-yellow-400 px-1.5 py-0.5 rounded text-[9px] font-bold">+{{ confirmed|length - 15 }}</span>
                                            {% endif %}
                                            {% if confirmed is empty %}<span class="text-gray-600 italic text-[10px]">Aucun inscrit</span>{% endif %}
                                        </div>
                                    </div>

                                    {# --- DOUBLE BOUTONS (VOIR / S'INSCRIRE) --- #}
                                        <div class="mt-auto pt-4 flex flex-col gap-2">
                                        {# Bouton S'INSCRIRE (En premier et en évidence) #}
                                        <a href="{{ path('app_evenement_show', {id: event.id}) }}"
                                        class="group flex items-center justify-center py-2.5 rounded font-bold border border-[#4a5ab8] bg-gradient-to-b from-[#1a237e] to-[#000051] text-[#ffd700] hover:text-white hover:border-[#ffd700] hover:shadow-[0_0_15px_rgba(255,215,0,0.4)] transition-all uppercase tracking-wider text-sm shadow-md">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 group-hover:animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                            </svg>
                                            S'inscrire
                                        </a>

                                        {# Bouton VOIR (En dessous, plus discret) #}
                                        <a href="{{ path('app_evenement_show', {id: event.id}) }}"
                                        class="flex items-center justify-center py-2 rounded text-xs font-bold border border-gray-600 bg-black/40 text-gray-400 hover:bg-gray-800 hover:text-white hover:border-gray-400 transition-all uppercase tracking-wide">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                            Détails
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="h-full flex flex-col items-center justify-center text-gray-600 opacity-50 gap-4">
                                <span class="text-4xl">💤</span>
                                <span class="text-lg font-fantasy tracking-wide">Repos</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

        {# ======================================= #}
        {# 3. BOUTON GÉRER PERSONNAGE (ÉPIQUE)     #}
        {# ======================================= #}

        <div class="relative w-full max-w-4xl mx-auto text-center">
            <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-xl blur opacity-25 animate-pulse"></div>

            <a href="{{ path('app_profile_index') }}" class="relative block w-full group overflow-hidden rounded-xl border-2 border-[#bfa670] bg-gray-900 shadow-2xl transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_0_40px_rgba(28,78,216,0.5)]">
                <div class="absolute inset-0 bg-[url('https://img.freepik.com/free-photo/grunge-concrete-texture_1194-6663.jpg')] opacity-20 mix-blend-overlay"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-[#0d1b3e] via-[#1c2c5b] to-[#0d1b3e] group-hover:via-[#2a4080] transition-colors duration-500"></div>

                <div class="relative flex flex-col md:flex-row items-center justify-between px-8 py-6 gap-6">
                    <div class="flex items-center gap-6 text-left">
                        <div class="p-4 rounded-full bg-black/40 border border-[#bfa670] shadow-inner group-hover:scale-110 transition-transform duration-300">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[#ffd700]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-3xl md:text-4xl font-fantasy text-[#ffd700] tracking-wider drop-shadow-md group-hover:text-white transition-colors">
                                MON PERSONNAGE
                            </h2>
                            <p class="text-blue-200 text-sm md:text-base font-sans mt-1">
                                Mettre à jour ma classe, ma spécialisation et ma BiS List
                            </p>
                        </div>
                    </div>
                    <div class="hidden md:block">
                        <span class="text-[#bfa670] font-bold text-lg uppercase tracking-widest border border-[#bfa670]/30 px-6 py-2 rounded bg-black/20 group-hover:bg-[#bfa670] group-hover:text-black transition-all duration-300">
                            Gérer
                        </span>
                    </div>
                </div>
            </a>
        </div>

        <p class="text-center text-gray-500 mt-6 text-sm">
            Gardez votre profil à jour pour aider les officiers à organiser le Roster.
        </p>

    </div>
{% endblock %}
