{% extends 'base.html.twig' %}

{% block title %}Accueil - Calendrier de la Guilde{% endblock %}

{% block body %}
    {# --- VARIABLES ET ICÔNES --- #}
    {% set currentWeekOffset = app.request.query.get('week', 0) %}

    {# Icônes SVG pour les rôles #}
    {% set roleIcons = {
        'Tank': '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 inline mr-1 text-blue-400" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" /></svg>',
        'Soigneur': '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 inline mr-1 text-green-400" viewBox="0 0 20 20" fill="currentColor"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" /></svg>',
        'DPS': '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 inline mr-1 text-red-500" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" /></svg>'
    } %}

    <div class="container mx-auto px-4 pb-12 max-w-[1600px]">

        {# ======================================= #}
        {# 1. TITRE ET NAVIGATION SEMAINE          #}
        {# ======================================= #}
        <div class="text-center mb-10">
            <h1 class="text-5xl font-fantasy header-title mb-4 drop-shadow-md">
                Agenda de la Guilde
            </h1>

            {# BARRE DE NAVIGATION #}
            <div class="inline-flex items-center gap-4 bg-black/40 border border-[#6d5d52] p-2 rounded-full backdrop-blur-sm">

                {# Précédent #}
                <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'week': currentWeekOffset - 1})) }}"
                class="w-10 h-10 flex items-center justify-center rounded-full bg-[#1a1a1a] border border-[#6d5d52] text-[#8b7355] hover:text-[#daa520] hover:border-[#daa520] transition-all hover:scale-110">
                    ❮
                </a>

                {# Date #}
                <div class="px-6 text-center min-w-[200px]">
                    <span class="block text-[10px] text-gray-500 uppercase tracking-widest font-bold">Semaine du</span>
                    <div class="text-xl font-fantasy text-[#f0e6d2]">
                        {{ weekDays|first|date('d M') }} <span class="text-[#daa520] mx-1">-</span> {{ weekDays|last|date('d M') }}
                    </div>
                    {% if currentWeekOffset != 0 %}
                        <a href="{{ path(app.request.attributes.get('_route')) }}" class="text-[10px] text-[#daa520] hover:underline block mt-1">
                            Revenir à aujourd'hui
                        </a>
                    {% endif %}
                </div>

                {# Suivant #}
                <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'week': currentWeekOffset + 1})) }}"
                class="w-10 h-10 flex items-center justify-center rounded-full bg-[#1a1a1a] border border-[#6d5d52] text-[#8b7355] hover:text-[#daa520] hover:border-[#daa520] transition-all hover:scale-110">
                    ❯
                </a>
            </div>
        </div>


        {# ======================================= #}
        {# 2. CALENDRIER HEBDOMADAIRE (GRID)       #}
        {# ======================================= #}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-7 gap-4 mb-16">
            {% for day in weekDays %}

                {# --- LOGIQUE DE DATE CORRIGÉE (Force Paris pour éviter les décalages) --- #}
                {% set todayDate = "now"|date("Y-m-d", "Europe/Paris") %}
                {% set currentDayDate = day|date("Y-m-d", "Europe/Paris") %}

                {% set isToday = (currentDayDate == todayDate) %}
                {% set isPast = (currentDayDate < todayDate) %}

                {% set dayKey = day|date('Y-m-d') %}
                {% set eventsToday = calendarEvents[dayKey] ?? [] %}

                {# --- COLONNE JOUR --- #}
                {# Note : J'ai ajouté 'ring-1' et '!border' pour forcer le style doré #}
                <div class="wow-panel flex flex-col min-h-[500px] transition-all duration-300 relative !overflow-visible
                    {% if isToday %}
                        !border-[#daa520] ring-1 ring-[#daa520] shadow-[0_0_20px_rgba(218,165,32,0.25)] z-10 scale-[1.02] bg-gradient-to-b from-[#3a2e22] to-[#0b0d12]
                    {% elseif isPast %}
                        opacity-60 grayscale border-[#333]
                    {% endif %}">

                    {# Badge "Aujourd'hui" #}
                    {% if isToday %}
                        <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-[#daa520] text-black text-[10px] font-bold px-3 py-0.5 rounded uppercase tracking-widest shadow-[0_0_10px_rgba(218,165,32,0.6)] z-20 border border-white/20">
                            Aujourd'hui
                        </div>
                    {% endif %}

                    {# En-tête Date #}
                    <div class="p-3 text-center border-b border-[#6d5d52]/30 bg-black/20">
                        <h3 class="font-fantasy tracking-wider uppercase {{ isToday ? 'text-[#daa520] text-xl font-bold drop-shadow-md' : 'text-[#8b7355] text-lg' }}">
                            {{ day|date('l')|trans }}
                        </h3>
                        <span class="text-xs font-sans {{ isToday ? 'text-white font-bold' : 'text-gray-600' }}">
                            {{ day|date('d F') }}
                        </span>
                    </div>

                    {# Liste des événements #}
                    <div class="p-2 flex-grow flex flex-col gap-3 overflow-y-auto custom-scrollbar bg-black/10">
                        {% if eventsToday is not empty %}
                            {% for event in eventsToday %}

                                {# Vérif inscription #}
                                {% set myInscription = null %}
                                {% if app.user %}
                                    {% for inscription in event.inscriptions %}
                                        {% if inscription.user.id == app.user.id %}
                                            {% set myInscription = inscription %}
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}

                                {# --- CARTE ÉVÉNEMENT --- #}
                                <div class="bg-[#151720] border border-[#6d5d52]/50 rounded p-3 flex flex-col gap-2 shadow-sm hover:border-[#daa520] transition-colors group h-full">

                                    {# 1. Header Carte #}
                                    <div class="flex justify-between items-start border-b border-[#6d5d52]/20 pb-2">
                                        <h4 class="font-bold text-[#f0e6d2] group-hover:text-white leading-tight text-sm truncate pr-1">
                                            {{ event.nom }}
                                        </h4>
                                        <span class="text-[10px] font-mono text-[#daa520] bg-black/40 px-1 py-0.5 rounded">
                                            {{ event.dateDebut|date('H:i') }}
                                        </span>
                                    </div>

                                    {# 2. Infos Roster (Stats) #}
                                    <div class="grid grid-cols-3 gap-1 text-[10px] bg-black/30 rounded py-1 border border-[#333]">
                                        <div class="text-center border-r border-[#333]">
                                            {{ roleIcons['Tank']|raw }}
                                            <span class="font-bold text-gray-400">{{ event.inscriptions|filter(i => i.playedRole == 'Tank' and i.statut == 'Confirmé')|length }}</span>
                                        </div>
                                        <div class="text-center border-r border-[#333]">
                                            {{ roleIcons['Soigneur']|raw }}
                                            <span class="font-bold text-gray-400">{{ event.inscriptions|filter(i => i.playedRole == 'Soigneur' and i.statut == 'Confirmé')|length }}</span>
                                        </div>
                                        <div class="text-center">
                                            {{ roleIcons['DPS']|raw }}
                                            <span class="font-bold text-gray-400">{{ event.inscriptions|filter(i => i.playedRole == 'DPS' and i.statut == 'Confirmé')|length }}</span>
                                        </div>
                                    </div>

                                    {# 3. Listing des pseudos #}
                                    <div class="flex-grow">
                                        <div class="flex flex-wrap gap-1 content-start mt-1">
                                            {% set confirmed = event.inscriptions|filter(i => i.statut == 'Confirmé') %}
                                            {% for inscription in confirmed|slice(0, 12) %}
                                                <span class="bg-[#2a241f] text-[#c7b394] px-1.5 py-0.5 rounded text-[9px] border border-[#6d5d52]/50 truncate max-w-[80px]">
                                                    {{ inscription.user.pseudo }}
                                                </span>
                                            {% endfor %}
                                            {% if confirmed|length > 12 %}
                                                <span class="bg-[#6d5d52] text-black px-1.5 py-0.5 rounded text-[9px] font-bold">+{{ confirmed|length - 12 }}</span>
                                            {% endif %}
                                            {% if confirmed is empty %}
                                                <span class="text-gray-600 italic text-[10px]">Aucun inscrit</span>
                                            {% endif %}
                                        </div>
                                    </div>

                                    {# 4. BOUTONS D'ACTION #}
                                    <div class="mt-auto pt-3 flex flex-col gap-2">
                                        {% if not isPast %}
                                            {% if myInscription %}
                                                <a href="{{ path('app_evenement_show', {id: event.id}) }}" class="w-full flex items-center justify-center py-1.5 bg-green-900/20 border border-green-800 text-green-500 text-xs font-bold rounded hover:bg-green-900/40 hover:text-green-300 transition-colors uppercase tracking-wider">
                                                    ✓ Inscrit
                                                </a>
                                            {% else %}
                                                <a href="{{ path('app_evenement_show', {id: event.id}) }}" class="w-full flex items-center justify-center py-1.5 bg-[#daa520]/10 border border-[#daa520] text-[#daa520] text-xs font-bold rounded hover:bg-[#daa520] hover:text-black transition-colors uppercase tracking-wider shadow-[0_0_5px_rgba(218,165,32,0.1)]">
                                                    S'inscrire
                                                </a>
                                            {% endif %}
                                        {% endif %}

                                        <a href="{{ path('app_evenement_show', {id: event.id}) }}" class="w-full text-center py-1 text-xs text-[#8b7355] border border-[#6d5d52] rounded bg-black/20 hover:bg-[#6d5d52] hover:text-white transition-colors">
                                            {% if isPast %}Résumé{% else %}Détails{% endif %}
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="h-full flex flex-col items-center justify-center text-[#6d5d52] opacity-50 gap-2 min-h-[100px]">
                                <span class="text-2xl">💤</span>
                                <span class="text-xs font-fantasy tracking-widest uppercase">Repos</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>


        {# ======================================= #}
        {# 3. BANNIÈRE "MON PERSONNAGE"            #}
        {# ======================================= #}
        <div class="relative w-full max-w-4xl mx-auto mt-20 group">
            {# Effet de lueur derrière #}
            <div class="absolute -inset-1 bg-gradient-to-r from-[#daa520] to-[#b8860b] rounded-lg blur opacity-20 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"></div>

            <a href="{{ path('app_profile_index') }}" class="relative block w-full bg-[#0b0d12] border border-[#6d5d52] rounded-lg overflow-hidden shadow-2xl transition-transform hover:-translate-y-1">

                {# Fond texture #}
                <div class="absolute inset-0 bg-gradient-to-r from-[#0d1b3e] via-[#1c2c5b] to-[#0d1b3e] opacity-90"></div>
                <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/black-scales.png')] opacity-30"></div>

                <div class="relative flex flex-col md:flex-row items-center justify-between px-8 py-8 gap-6 z-10">

                    <div class="flex items-center gap-6">
                        {# Icône Cercle #}
                        <div class="p-4 rounded-full bg-black/40 border border-[#daa520] shadow-[inset_0_0_10px_rgba(218,165,32,0.3)] group-hover:scale-110 transition-transform duration-300">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[#ffd700]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>

                        {# Textes #}
                        <div class="text-center md:text-left">
                            <h2 class="text-3xl font-fantasy text-[#f0e6d2] tracking-widest drop-shadow-md group-hover:text-[#daa520] transition-colors">
                                ESPACE PERSONNEL
                            </h2>
                            <p class="text-gray-400 text-sm mt-1">
                                Mettez à jour votre classe, vos spécialisations et votre BiS List pour le Roster.
                            </p>
                        </div>
                    </div>

                    {# Bouton Action #}
                    <div>
                        <span class="inline-block px-8 py-3 bg-[#daa520] text-black font-bold uppercase tracking-widest text-sm rounded hover:bg-[#ffd700] transition-colors shadow-[0_0_15px_rgba(218,165,32,0.4)]">
                            Gérer mon profil
                        </span>
                    </div>
                </div>
            </a>
        </div>

    </div>
{% endblock %}
