<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Le Codex de Guilde{% endblock %}</title>
        <link rel="icon" href="{{ asset('images/logowow.png') }}">

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>

    <body class="bg-gray-900 text-gray-200">
        {{ include('partials/_navbar.html.twig') }}
        <div class="pt-24 min-h-screen">

        <header class="bg-gray-800 shadow-md">

        </header>

        <main class="container mx-auto px-6 py-8">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="p-4 mb-4 text-sm text-white rounded-lg {% if label == 'success' %} bg-green-600 {% elseif label == 'error' %} bg-red-600 {% else %} bg-blue-600 {% endif %}" role="alert">
                        <span class="font-medium">{{ message }}</span>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <script>const whTooltips = {colorLinks: true, iconizeLinks: true, renameLinks: true, domain: 'mop'};</script>
        <script src="https://wow.zamimg.com/js/tooltips.js"></script>
    </body>
</html>
